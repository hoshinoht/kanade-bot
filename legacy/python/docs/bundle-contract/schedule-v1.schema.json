{
  "$defs": {
    "Amendment": {
      "additionalProperties": false,
      "properties": {
        "bosses": {
          "items": {
            "type": "string"
          },
          "title": "Bosses",
          "type": "array"
        },
        "channel_id": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]{0,19}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "day_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day Ref"
        },
        "evidence_msg_ids": {
          "items": {
            "pattern": "^[1-9][0-9]{0,19}$",
            "type": "string"
          },
          "title": "Evidence Msg Ids",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "is_question": {
          "title": "Is Question",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "move",
            "add",
            "cancel",
            "otot",
            "split",
            "sub",
            "rsvp",
            "fix"
          ],
          "title": "Kind",
          "type": "string"
        },
        "new_datetime": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Datetime"
        },
        "participants": {
          "items": {
            "pattern": "^[1-9][0-9]{0,19}$",
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "payload": {
          "$ref": "#/$defs/AmendmentPayload"
        },
        "proposal_message_id": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]{0,19}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Message Id"
        },
        "rsvp": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "maybe"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rsvp"
        },
        "run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "status": {
          "enum": [
            "proposed",
            "confirmed",
            "rejected",
            "expired",
            "superseded",
            "withdrawn"
