      "title": "Amendment",
      "type": "object"
    },
    "AmendmentPayload": {
      "additionalProperties": false,
      "description": "Closed union of v4 `fix`, `split`, `sub`, and annotation envelopes.",
      "properties": {
        "add": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[1-9][0-9]{0,19}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Add"
        },
        "also_mentioned": {
          "items": {
            "enum": [
              "move",
              "add",
              "cancel",
              "otot",
              "split",
              "sub",
              "rsvp",
              "fix"
            ],
            "type": "string"
          },
          "title": "Also Mentioned",
          "type": "array"
        },
        "bosses": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bosses"
        },
        "fixed_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Run Id"
        },
        "op": {
          "anyOf": [
            {
              "enum": [
                "remove",
                "edit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op"
        },
        "participants": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[1-9][0-9]{0,19}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participants"
        },
        "remove": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[1-9][0-9]{0,19}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remove"
        },
        "time": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "weekday": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weekday"
        },
        "weekly_when": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weekly When"
        }
      },
      "title": "AmendmentPayload",
      "type": "object"
    },
