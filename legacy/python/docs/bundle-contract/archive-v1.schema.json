{
  "$defs": {
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "exported_at": {
          "format": "date-time",
          "title": "Exported At",
          "type": "string"
        },
        "format_version": {
          "const": 1,
          "title": "Format Version",
          "type": "integer"
        },
        "guild_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Guild Id",
          "type": "string"
        },
        "memory_preflight_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Memory Preflight Counts",
          "type": "object"
        }
      },
      "required": [
        "format_version",
        "guild_id",
        "exported_at",
        "memory_preflight_counts"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "SectionMetadata": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "title": "SectionMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archive_version": {
      "const": 1,
      "title": "Archive Version",
      "type": "integer"
    },
    "bundle_manifest": {
      "$ref": "#/$defs/Manifest"
    },
    "sections": {
      "additionalProperties": {
        "$ref": "#/$defs/SectionMetadata"
      },
      "propertyNames": {
        "enum": [
          "schedule.json",
          "config.json",
          "history.json",
          "catalog.json",
          "delivery.json",
          "rate_overrides.json"
        ]
      },
      "title": "Sections",
      "type": "object"
    }
  },
  "required": [
    "archive_version",
    "bundle_manifest",
    "sections"
  ],
  "title": "ArchiveManifest",
  "type": "object"
}
