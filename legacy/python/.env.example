# Copy to `.env` and fill in; `.env` is git-ignored.
# Only must-set values are listed. Every other setting, its default and its
# cautions: docs/setup.md#settings-reference.

# ---------------------------------------------------------------- Discord ---
# Bot token (Developer Portal -> Bot -> Reset Token). Keep it secret.
DISCORD_TOKEN=
# Server id (right-click the server icon -> Copy Server ID).
GUILD_ID=
# Members with this role are bossers and may use the slash commands.
BOSSING_ROLE_ID=
# Watched party channels: set at least one of these, comma separated.
CHAT_CHANNEL_IDS=
CHAT_CATEGORY_IDS=

# ---------------------------------------------------------- portal + API ---
# Shared API/portal/bossctl token: `openssl rand -hex 32`. Empty refuses all.
ADMIN_TOKEN=

# ---------------------------------------------------------------- storage ---
# Shared absolute private (0700) directory for every persistent writer.
DB_OWNER_LOCK_DIR=

# ---------------------------------------------------------- model gateway ---
# File holding the Kanata bearer key (never the key itself). Compose fixes this
# to /run/secrets/kanata_api_key; set KANATA_API_KEY_HOST_FILE there instead.
KANATA_API_KEY_FILE=
# Gateway model alias for extraction; required while extraction is enabled.
EXTRACT_MODEL=

# ------------------------------------------------ chatbot (optional) -------
# Leave blank to keep the chatbot off. Channel and category lists are separate
# from the extractor's: a category holding party channels makes the bot answer
# in them too, so prefer a dedicated chat channel.
CHAT_PILOT_ROLE_ID=
CHAT_PILOT_CHANNEL_IDS=
CHAT_PILOT_CATEGORY_IDS=
# Required once either chatbot list is set.
CHAT_PILOT_MODEL=
