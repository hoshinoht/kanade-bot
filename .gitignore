.env
# Environment variants may contain the same secrets.
.env.*
!.env.example
data/
.venv/
target/
__pycache__/
*.py[cod]
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Generated from portal.scss.
bot/api/static/portal.css
.pytest_cache/
.ruff_cache/
.DS_Store
.opencode/*

# Untracked game assets.
boss/portraits/*
!boss/portraits/README.md

boss/artwork/*/*
!boss/artwork/*/README.md

# Guide content — editable per deployment, never committed.
config/guide.yaml
!config/guide.example.yaml
!config/README.md

# Staging presets — same pattern: example tracked, live file private.
config/presets/staging.yaml
!config/presets/staging.example.yaml

.claude

# v5 personas: track only the public examples; all live prompt content stays private.
config/personas/*
!config/personas/README.md
!config/personas/catalog.example.yaml
!config/personas/bundles/
config/personas/bundles/*
!config/personas/bundles/kanade.yaml
!config/personas/profiles/
config/personas/profiles/*
!config/personas/profiles/example.yaml
# Private v4 persona layout mounted by the v4 rollback container until cutover.
config/personas-v4/

# Local design notes.
DESIGN.md

# v5 PWA workspace build output and test artefacts.
web/**/node_modules/
web/**/dist/
web/e2e/.results/
web/e2e/.captures/
web/**/*.tsbuildinfo
tools/pwa-mock/target/
