.env
# Environment variants may contain the same secrets.
.env.*
!.env.example
data/
.venv/
__pycache__/
*.py[cod]
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Generated from portal.scss.
bot/api/static/portal.css
.pytest_cache/
.ruff_cache/
.DS_Store
.opencode/*

# Untracked game assets.
boss/portraits/*
!boss/portraits/README.md

boss/artwork/*/*
!boss/artwork/*/README.md

# Guide content — editable per deployment, never committed.
config/guide.yaml
!config/guide.example.yaml
!config/README.md

# Staging presets — same pattern: example tracked, live file private.
config/presets/staging.yaml
!config/presets/staging.example.yaml

.claude

# Track templates only; all live prompt content stays private.
config/personas/*
!config/personas/README.md
!config/personas/personas.example.yaml
!config/personas/personas/
config/personas/personas/*
!config/personas/personas/kanade/
!config/personas/personas/kanade/identity.md
!config/personas/personas/kanade/default.md
!config/personas/personas/kanade/staging.yaml
!config/personas/behaviour-plugins/
config/personas/behaviour-plugins/*
!config/personas/behaviour-plugins/example.md
!config/personas/behaviours/
config/personas/behaviours/*
!config/personas/behaviours/example.md
!config/personas/behaviours/staging/
config/personas/behaviours/staging/*
!config/personas/behaviours/staging/example.yaml

# Local design notes.
DESIGN.md

# The live Caddyfile names the private domain.
caddy/Caddyfile
!caddy/Caddyfile.example
