.env
# Environment variants may contain the same secrets.
.env.*
!.env.example
# Private v5 settings; kanade.example.toml is the tracked template.
/kanade.toml
data/
.venv/
target/
__pycache__/
*.py[cod]
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Generated from portal.scss.
bot/api/static/portal.css
.pytest_cache/
.ruff_cache/
.DS_Store
.opencode/*

# Untracked game assets.
boss/portraits/*
!boss/portraits/README.md

boss/artwork/*/*
!boss/artwork/*/README.md

# Guide content — editable per deployment, never committed.
config/guide.yaml
!config/guide.example.yaml
!config/README.md

# Staging presets — same pattern: example tracked, live file private.
config/presets/staging.yaml
!config/presets/staging.example.yaml

.claude

# v5 personas: track only the public examples; all live prompt content stays private.
config/personas/*
!config/personas/README.md
!config/personas/catalog.example.yaml
!config/personas/bundles/
config/personas/bundles/*
!config/personas/bundles/kanade.yaml
!config/personas/profiles/
config/personas/profiles/*
!config/personas/profiles/example.yaml
# Private v4 persona layout mounted by the v4 rollback container until cutover.
config/personas-v4/

# Local design notes.
DESIGN.md

# v5 PWA workspace build output and test artefacts.
web/**/node_modules/
web/**/dist/
web/e2e/.results/
web/e2e/.results-rust/
web/e2e/.captures/
web/**/*.tsbuildinfo
devtools/pwa-mock/target/

# Local design research captures (kept on disk, not tracked)
/docs/research/

# Private dev notes, logs, plans and reviews (kept on disk, never tracked; see its AGENTS.md)
/docs/notes/

# Frozen v4 rollback tree: local only, never tracked again (in git history up to 487c4ed).
/legacy/python/

# docs/v5: only the setup guides and the test data (frozen vectors, API
# schemas) are public; contracts, design specs and evaluations stay local.
/docs/v5/*
!/docs/v5/runtime-bootstrap.md
!/docs/v5/v4-import.md
!/docs/v5/vectors/
!/docs/v5/api-schemas/
