{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5 scheduler reminder dispatch oracle vectors",
  "type": "object",
  "required": ["schema_version", "family", "provenance", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v5-scheduler-dispatch-v1"},
    "family": {"const": "dispatch"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "snowflake": {"type": "string", "pattern": "^[0-9]+$"},
    "nullableSnowflake": {"oneOf": [{"$ref": "#/$defs/snowflake"}, {"type": "null"}]},
    "instant": {"type": "string", "format": "date-time"},
    "clockTime": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"},
    "hhmm": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "weekday": {"type": "integer", "minimum": 0, "maximum": 6},
    "status": {"enum": ["planned", "confirmed", "at_risk", "otot", "done", "cancelled"]},
    "runSource": {"enum": ["fixed", "amend"]},
    "rsvpState": {"enum": ["yes", "no", "maybe"]},
    "rsvpSource": {"enum": ["reaction", "chat", "slash"]},
    "storedKind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "nullableId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "provenance": {
      "type": "object",
      "required": ["oracle", "functions", "source_tests", "inventory_surfaces"],
      "additionalProperties": false,
      "properties": {
        "oracle": {"type": "string", "minLength": 1},
        "functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "source_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^tests/test_[a-z0-9_]+\\.py::test_[A-Za-z0-9_]+$"}},
        "inventory_surfaces": {"$ref": "#/$defs/strings"}
      }
    },
    "catalog": {
      "type": "object",
      "required": ["difficulties", "bosses"],
      "additionalProperties": false,
      "properties": {
        "difficulties": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["prefix", "label"], "additionalProperties": false, "properties": {"prefix": {"type": "string", "pattern": "^[a-z]$"}, "label": {"$ref": "#/$defs/id"}}}},
        "bosses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["short"], "additionalProperties": false, "properties": {"short": {"$ref": "#/$defs/id"}, "full": {"$ref": "#/$defs/id"}, "level": {"type": "integer", "minimum": 1}, "difficulties": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]$"}}, "aliases": {"$ref": "#/$defs/strings"}}}}
      }
    },
    "member": {
      "type": "object",
      "required": ["user_id", "display_name", "nickname", "has_role", "ping_level"],
      "additionalProperties": false,
      "properties": {"user_id": {"$ref": "#/$defs/snowflake"}, "display_name": {"$ref": "#/$defs/id"}, "nickname": {"$ref": "#/$defs/nullableId"}, "has_role": {"type": "boolean"}, "ping_level": {"enum": ["essential", "all", "off"]}}
    },
    "replayCase": {
      "type": "object",
      "required": ["case_id", "input"],
      "additionalProperties": false,
      "properties": {"case_id": {"$ref": "#/$defs/id"}, "input": {"$ref": "#/$defs/input"}, "expected": {"$ref": "#/$defs/expected"}}
    },
    "case": {"allOf": [{"$ref": "#/$defs/replayCase"}, {"required": ["expected"]}]},
    "input": {
      "type": "object",
      "required": ["clock", "timezone", "reset_weekday", "reset_time", "ping_time", "countdowns", "guild_id", "post_channel_id", "available_channel_ids", "catalog", "members", "uuid_sequence", "steps"],
      "additionalProperties": false,
      "properties": {
        "clock": {"$ref": "#/$defs/instant"},
        "timezone": {"type": "string", "minLength": 1},
        "reset_weekday": {"$ref": "#/$defs/weekday"},
        "reset_time": {"$ref": "#/$defs/clockTime"},
        "ping_time": {"$ref": "#/$defs/clockTime"},
        "countdowns": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "guild_id": {"$ref": "#/$defs/snowflake"},
        "post_channel_id": {"$ref": "#/$defs/nullableSnowflake"},
        "available_channel_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/snowflake"}},
        "catalog": {"$ref": "#/$defs/catalog"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "uuid_sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      }
    },
    "step": {"oneOf": [
      {"type": "object", "required": ["op", "run_key", "week_start", "bosses", "at", "participants", "status", "source", "channel_id"], "additionalProperties": false, "properties": {"op": {"const": "create_run"}, "run_key": {"$ref": "#/$defs/id"}, "week_start": {"$ref": "#/$defs/instant"}, "bosses": {"$ref": "#/$defs/strings"}, "at": {"$ref": "#/$defs/instant"}, "participants": {"type": "array", "items": {"$ref": "#/$defs/snowflake"}}, "status": {"$ref": "#/$defs/status"}, "source": {"$ref": "#/$defs/runSource"}, "channel_id": {"$ref": "#/$defs/nullableSnowflake"}}},
      {"type": "object", "required": ["op", "run_key", "user_id", "state", "source"], "additionalProperties": false, "properties": {"op": {"const": "set_rsvp"}, "run_key": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/snowflake"}, "state": {"$ref": "#/$defs/rsvpState"}, "source": {"$ref": "#/$defs/rsvpSource"}}},
      {"type": "object", "required": ["op", "run_key", "status"], "additionalProperties": false, "properties": {"op": {"const": "set_status"}, "run_key": {"$ref": "#/$defs/id"}, "status": {"$ref": "#/$defs/status"}}},
      {"type": "object", "required": ["op", "clock"], "additionalProperties": false, "properties": {"op": {"const": "set_clock"}, "clock": {"$ref": "#/$defs/instant"}}},
      {"type": "object", "required": ["op", "fail_sends"], "additionalProperties": false, "properties": {"op": {"const": "set_transport"}, "fail_sends": {"type": "boolean"}}},
      {"type": "object", "required": ["op", "run_key", "kind", "fire_at"], "additionalProperties": false, "properties": {"op": {"const": "add_reminder"}, "run_key": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/storedKind"}, "fire_at": {"$ref": "#/$defs/instant"}}},
      {"type": "object", "required": ["op"], "additionalProperties": false, "properties": {"op": {"enum": ["due_reminders", "dispatch_reminders", "mark_done"]}}}
    ]},
    "result_create_run": {"$ref": "#/$defs/id"},
    "result_set_rsvp": {"$ref": "#/$defs/rsvpState"},
    "result_set_status": {"$ref": "#/$defs/status"},
    "result_set_clock": {"$ref": "#/$defs/instant"},
    "result_set_transport": {"type": "boolean"},
    "result_add_reminder": {"$ref": "#/$defs/nullableId"},
    "result_due_reminders": {"type": "array", "items": {"type": "object", "required": ["id", "kind"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/storedKind"}}}},
    "result_dispatch_reminders": {"type": "null"},
    "result_mark_done": {"$ref": "#/$defs/strings"},
    "stepResult": {"oneOf": [
      {"type": "object", "required": ["value"], "additionalProperties": false, "properties": {"value": {"anyOf": [
        {"$ref": "#/$defs/result_create_run"}, {"$ref": "#/$defs/result_set_transport"}, {"$ref": "#/$defs/result_add_reminder"},
        {"$ref": "#/$defs/result_due_reminders"}, {"$ref": "#/$defs/result_mark_done"}
      ]}}},
      {"type": "object", "required": ["error"], "additionalProperties": false, "properties": {"error": {"type": "object", "required": ["type", "message"], "additionalProperties": false, "properties": {"type": {"const": "ValueError"}, "message": {"type": "string", "minLength": 1}}}}}
    ]},
    "intent": {
      "type": "object",
      "required": ["effect_kind", "channel_id", "dedupe_scope", "targets", "mentions", "role_mentions", "mention_everyone", "outcome"],
      "additionalProperties": false,
      "properties": {
        "effect_kind": {"const": "reminder"},
        "channel_id": {"$ref": "#/$defs/snowflake"},
        "dedupe_scope": {"enum": ["native", "operation", "source"]},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["binding_type", "key_primary", "key_secondary"], "additionalProperties": false, "properties": {"binding_type": {"const": "reminder"}, "key_primary": {"$ref": "#/$defs/id"}, "key_secondary": {"type": "null"}}}},
        "mentions": {"type": "array", "items": {"$ref": "#/$defs/snowflake"}},
        "role_mentions": {"type": "array", "maxItems": 0},
        "mention_everyone": {"const": false},
        "outcome": {"enum": ["bound", "suppressed", "indeterminate", "raised:DeliveryBindingError", "raised:DeliveryUncertainError"]}
      }
    },
    "runRow": {"type": "object", "required": ["id", "fixed_run_id", "channel_id", "bosses", "participants", "status", "source", "week_start", "datetime"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "fixed_run_id": {"$ref": "#/$defs/nullableId"}, "channel_id": {"$ref": "#/$defs/nullableId"}, "bosses": {"$ref": "#/$defs/strings"}, "participants": {"$ref": "#/$defs/strings"}, "status": {"$ref": "#/$defs/status"}, "source": {"$ref": "#/$defs/runSource"}, "week_start": {"$ref": "#/$defs/instant"}, "datetime": {"$ref": "#/$defs/instant"}}},
    "reminderRow": {"type": "object", "required": ["id", "run_id", "kind", "fire_at", "sent_at", "message_id"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/storedKind"}, "fire_at": {"$ref": "#/$defs/instant"}, "sent_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "message_id": {"$ref": "#/$defs/nullableSnowflake"}}},
    "rsvpRow": {"type": "object", "required": ["run_id", "user_id", "state", "source", "at"], "additionalProperties": false, "properties": {"run_id": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "state": {"$ref": "#/$defs/rsvpState"}, "source": {"$ref": "#/$defs/rsvpSource"}, "at": {"$ref": "#/$defs/instant"}}},
    "expected": {"type": "object", "required": ["steps", "final_state"], "additionalProperties": false, "properties": {
      "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stepResult"}},
      "final_state": {"type": "object", "required": ["fixed_runs", "runs", "reminders", "rsvps", "side_effects"], "additionalProperties": false, "properties": {
        "fixed_runs": {"type": "array", "maxItems": 0},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/runRow"}},
        "reminders": {"type": "array", "items": {"$ref": "#/$defs/reminderRow"}},
        "rsvps": {"type": "array", "items": {"$ref": "#/$defs/rsvpRow"}},
        "side_effects": {"type": "array", "items": {"$ref": "#/$defs/intent"}}
      }}
    }}
  }
}
