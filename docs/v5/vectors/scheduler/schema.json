{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5 stateful scheduler oracle vectors",
  "type": "object",
  "required": ["schema_version", "family", "provenance", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v5-scheduler-v1"},
    "family": {"const": "scheduler"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "instant": {"type": "string", "format": "date-time"},
    "status": {"enum": ["planned", "confirmed", "at_risk", "otot", "done", "cancelled"]},
    "runSource": {"enum": ["fixed", "amend"]},
    "rsvpState": {"enum": ["yes", "no", "maybe"]},
    "rsvpSource": {"enum": ["reaction", "chat", "slash"]},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "provenance": {"type": "object", "required": ["oracle", "functions", "source_tests", "inventory_surfaces"], "additionalProperties": false, "properties": {"oracle": {"type": "string"}, "functions": {"$ref": "#/$defs/strings"}, "source_tests": {"$ref": "#/$defs/strings"}, "inventory_surfaces": {"$ref": "#/$defs/strings"}}},
    "replayCase": {"type": "object", "required": ["case_id", "input"], "additionalProperties": false, "properties": {"case_id": {"$ref": "#/$defs/id"}, "input": {"$ref": "#/$defs/input"}, "expected": {"$ref": "#/$defs/expected"}}},
    "case": {"allOf": [{"$ref": "#/$defs/replayCase"}, {"required": ["expected"]}]},
    "input": {"type": "object", "required": ["clock", "timezone", "reset_weekday", "reset_time", "ping_time", "countdowns", "week_start", "uuid_sequence", "steps"], "additionalProperties": false, "properties": {"clock": {"$ref": "#/$defs/instant"}, "timezone": {"type": "string", "minLength": 1}, "reset_weekday": {"type": "integer", "minimum": 0, "maximum": 6}, "reset_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"}, "ping_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"}, "countdowns": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "week_start": {"$ref": "#/$defs/instant"}, "uuid_sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}}},
    "step": {"oneOf": [
      {"type": "object", "required": ["op", "fixed_key", "owner_id", "bosses", "weekday", "time", "participants", "channel_id"], "additionalProperties": false, "properties": {"op": {"const": "add_fixed"}, "fixed_key": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"}, "bosses": {"$ref": "#/$defs/strings"}, "weekday": {"type": "integer", "minimum": 0, "maximum": 6}, "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}, "participants": {"$ref": "#/$defs/strings"}, "channel_id": {"$ref": "#/$defs/id"}}},
      {"type": "object", "required": ["op", "run_key", "bosses", "at", "participants", "status", "source", "channel_id"], "additionalProperties": false, "properties": {"op": {"const": "create_run"}, "run_key": {"$ref": "#/$defs/id"}, "bosses": {"$ref": "#/$defs/strings"}, "at": {"$ref": "#/$defs/instant"}, "participants": {"$ref": "#/$defs/strings"}, "status": {"$ref": "#/$defs/status"}, "source": {"$ref": "#/$defs/runSource"}, "channel_id": {"$ref": "#/$defs/id"}}},
      {"type": "object", "required": ["op"], "additionalProperties": false, "properties": {"op": {"const": "materialise"}}},
      {"type": "object", "required": ["op", "week_start"], "additionalProperties": false, "properties": {"op": {"const": "materialise"}, "week_start": {"$ref": "#/$defs/instant"}}},
      {"type": "object", "required": ["op", "run_key", "status"], "additionalProperties": false, "properties": {"op": {"const": "set_status"}, "run_key": {"$ref": "#/$defs/id"}, "status": {"$ref": "#/$defs/status"}}},
      {"type": "object", "required": ["op", "run_key", "user_id", "state", "source"], "additionalProperties": false, "properties": {"op": {"const": "set_rsvp"}, "run_key": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "state": {"$ref": "#/$defs/rsvpState"}, "source": {"$ref": "#/$defs/rsvpSource"}}},
      {"type": "object", "required": ["op", "run_key", "user_id", "state", "source", "error_type"], "additionalProperties": false, "properties": {"op": {"const": "set_rsvp"}, "run_key": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "state": {"const": "unknown"}, "source": {"$ref": "#/$defs/rsvpSource"}, "error_type": {"const": "ValueError"}}},
      {"type": "object", "required": ["op", "run_key", "user_id", "emoji", "added"], "additionalProperties": false, "properties": {"op": {"const": "reaction"}, "run_key": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "emoji": {"enum": ["✅", "❌", "🍕"]}, "added": {"type": "boolean"}}},
      {"type": "object", "required": ["op", "fixed_key", "fields", "changed", "week_starts"], "additionalProperties": false, "properties": {"op": {"const": "edit_fixed"}, "fixed_key": {"$ref": "#/$defs/id"}, "fields": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"weekday": {"type": "integer", "minimum": 0, "maximum": 6}, "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}}}, "changed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["weekday", "time"]}}, "week_starts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instant"}}}},
      {"type": "object", "required": ["op", "fixed_key", "week_starts"], "additionalProperties": false, "properties": {"op": {"const": "retire_fixed"}, "fixed_key": {"$ref": "#/$defs/id"}, "week_starts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instant"}}}}
    ]},
    "stepResult": {"oneOf": [{"type": "object", "required": ["value"], "additionalProperties": false, "properties": {"value": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "integer", "minimum": 0}, {"type": "array", "items": {"$ref": "#/$defs/id"}}, {"$ref": "#/$defs/reactionResult"}]}}}, {"type": "object", "required": ["error"], "additionalProperties": false, "properties": {"error": {"type": "object", "required": ["type", "message"], "additionalProperties": false, "properties": {"type": {"const": "ValueError"}, "message": {"type": "string", "minLength": 1}}}}}]},
    "reactionResult": {"type": "object", "required": ["run_id", "applied", "state", "old_status", "new_status"], "additionalProperties": false, "properties": {"run_id": {"$ref": "#/$defs/id"}, "applied": {"type": "boolean"}, "state": {"oneOf": [{"$ref": "#/$defs/rsvpState"}, {"type": "null"}]}, "old_status": {"$ref": "#/$defs/status"}, "new_status": {"$ref": "#/$defs/status"}}},
    "fixedRow": {"type": "object", "required": ["id", "owner_id", "channel_id", "bosses", "weekday", "time", "participants", "note"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"}, "channel_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "bosses": {"$ref": "#/$defs/strings"}, "weekday": {"type": "integer", "minimum": 0, "maximum": 6}, "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}, "participants": {"$ref": "#/$defs/strings"}, "note": {"type": ["string", "null"]}}},
    "runRow": {"type": "object", "required": ["id", "fixed_run_id", "channel_id", "bosses", "participants", "status", "source", "week_start", "datetime"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "fixed_run_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "channel_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "bosses": {"$ref": "#/$defs/strings"}, "participants": {"$ref": "#/$defs/strings"}, "status": {"$ref": "#/$defs/status"}, "source": {"$ref": "#/$defs/runSource"}, "week_start": {"$ref": "#/$defs/instant"}, "datetime": {"$ref": "#/$defs/instant"}}},
    "reminderRow": {"type": "object", "required": ["id", "run_id", "kind", "fire_at", "sent_at"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "fire_at": {"$ref": "#/$defs/instant"}, "sent_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}}},
    "rsvpRow": {"type": "object", "required": ["run_id", "user_id", "state", "source", "at"], "additionalProperties": false, "properties": {"run_id": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "state": {"$ref": "#/$defs/rsvpState"}, "source": {"$ref": "#/$defs/rsvpSource"}, "at": {"$ref": "#/$defs/instant"}}},
    "expected": {"type": "object", "required": ["steps", "final_state"], "additionalProperties": false, "properties": {"steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stepResult"}}, "final_state": {"type": "object", "required": ["fixed_runs", "runs", "reminders", "rsvps", "side_effects"], "additionalProperties": false, "properties": {"fixed_runs": {"type": "array", "items": {"$ref": "#/$defs/fixedRow"}}, "runs": {"type": "array", "items": {"$ref": "#/$defs/runRow"}}, "reminders": {"type": "array", "items": {"$ref": "#/$defs/reminderRow"}}, "rsvps": {"type": "array", "items": {"$ref": "#/$defs/rsvpRow"}}, "side_effects": {"type": "array", "maxItems": 0}}}}}
  }
}
