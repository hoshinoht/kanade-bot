{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5 scheduler reminder oracle vectors",
  "type": "object",
  "required": ["schema_version", "family", "provenance", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v5-scheduler-reminders-v1"},
    "family": {"const": "reminders"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "instant": {"type": "string", "format": "date-time"},
    "clockTime": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"},
    "hhmm": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "status": {"enum": ["planned", "confirmed", "at_risk", "otot", "done", "cancelled"]},
    "runSource": {"enum": ["fixed", "amend"]},
    "rsvpState": {"enum": ["yes", "no", "maybe"]},
    "rsvpSource": {"enum": ["reaction", "chat", "slash"]},
    "reminderKind": {"type": "string", "pattern": "^(day_of|countdown_(0|[1-9][0-9]*))$"},
    "countdowns": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "nullableId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "provenance": {
      "type": "object",
      "required": ["oracle", "functions", "source_tests", "inventory_surfaces"],
      "additionalProperties": false,
      "properties": {
        "oracle": {"type": "string", "minLength": 1},
        "functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "source_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^tests/test_[a-z0-9_]+\\.py::test_[A-Za-z0-9_]+$"}},
        "inventory_surfaces": {"$ref": "#/$defs/strings"}
      }
    },
    "replayCase": {
      "type": "object",
      "required": ["case_id", "input"],
      "additionalProperties": false,
      "properties": {"case_id": {"$ref": "#/$defs/id"}, "input": {"$ref": "#/$defs/input"}, "expected": {"$ref": "#/$defs/expected"}}
    },
    "case": {"allOf": [{"$ref": "#/$defs/replayCase"}, {"required": ["expected"]}]},
    "input": {
      "type": "object",
      "required": ["clock", "timezone", "uuid_sequence", "steps"],
      "additionalProperties": false,
      "properties": {
        "clock": {"$ref": "#/$defs/instant"},
        "timezone": {"type": "string", "minLength": 1},
        "uuid_sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      }
    },
    "step": {"oneOf": [
      {"type": "object", "required": ["op", "fixed_key", "owner_id", "bosses", "weekday", "time", "participants", "channel_id"], "additionalProperties": false, "properties": {"op": {"const": "add_fixed"}, "fixed_key": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"}, "bosses": {"$ref": "#/$defs/strings"}, "weekday": {"type": "integer", "minimum": 0, "maximum": 6}, "time": {"$ref": "#/$defs/hhmm"}, "participants": {"$ref": "#/$defs/strings"}, "channel_id": {"$ref": "#/$defs/id"}}},
      {"type": "object", "required": ["op", "run_key", "week_start", "bosses", "at", "participants", "status", "source", "channel_id"], "additionalProperties": false, "properties": {"op": {"const": "create_run"}, "run_key": {"$ref": "#/$defs/id"}, "week_start": {"$ref": "#/$defs/instant"}, "bosses": {"$ref": "#/$defs/strings"}, "at": {"$ref": "#/$defs/instant"}, "participants": {"$ref": "#/$defs/strings"}, "status": {"$ref": "#/$defs/status"}, "source": {"$ref": "#/$defs/runSource"}, "channel_id": {"$ref": "#/$defs/id"}}},
      {"type": "object", "required": ["op", "week_start", "ping_time", "countdowns"], "additionalProperties": false, "properties": {"op": {"const": "materialise"}, "week_start": {"$ref": "#/$defs/instant"}, "ping_time": {"$ref": "#/$defs/clockTime"}, "countdowns": {"$ref": "#/$defs/countdowns"}}},
      {"type": "object", "required": ["op", "run_key", "status"], "additionalProperties": false, "properties": {"op": {"const": "set_status"}, "run_key": {"$ref": "#/$defs/id"}, "status": {"$ref": "#/$defs/status"}}},
      {"type": "object", "required": ["op", "run_key", "status", "error_type"], "additionalProperties": false, "properties": {"op": {"const": "set_status"}, "run_key": {"$ref": "#/$defs/id"}, "status": {"type": "string", "not": {"$ref": "#/$defs/status"}}, "error_type": {"const": "ValueError"}}},
      {"type": "object", "required": ["op", "clock"], "additionalProperties": false, "properties": {"op": {"const": "set_clock"}, "clock": {"$ref": "#/$defs/instant"}}},
      {"type": "object", "required": ["op", "at", "status", "ping_time", "countdowns"], "additionalProperties": false, "properties": {"op": {"const": "reminder_specs"}, "at": {"$ref": "#/$defs/instant"}, "status": {"$ref": "#/$defs/status"}, "ping_time": {"$ref": "#/$defs/clockTime"}, "countdowns": {"$ref": "#/$defs/countdowns"}}},
      {"type": "object", "required": ["op", "run_key", "ping_time", "countdowns", "rebuild"], "additionalProperties": false, "properties": {"op": {"const": "ensure_reminders"}, "run_key": {"$ref": "#/$defs/id"}, "ping_time": {"$ref": "#/$defs/clockTime"}, "countdowns": {"$ref": "#/$defs/countdowns"}, "rebuild": {"type": "boolean"}}},
      {"type": "object", "required": ["op", "run_key", "kind", "fire_at", "sent_at"], "additionalProperties": false, "properties": {"op": {"const": "add_reminder"}, "run_key": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/reminderKind"}, "fire_at": {"$ref": "#/$defs/instant"}, "sent_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}}},
      {"type": "object", "required": ["op", "run_key", "kind", "message_id"], "additionalProperties": false, "properties": {"op": {"const": "mark_reminder_sent"}, "run_key": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/reminderKind"}, "message_id": {"$ref": "#/$defs/nullableId"}}},
      {"type": "object", "required": ["op", "run_key", "kind", "fire_at"], "additionalProperties": false, "properties": {"op": {"const": "reschedule_unposted_reminder"}, "run_key": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/reminderKind"}, "fire_at": {"$ref": "#/$defs/instant"}}},
      {"type": "object", "required": ["op", "ping_time"], "additionalProperties": false, "properties": {"op": {"const": "reconcile_day_of"}, "ping_time": {"$ref": "#/$defs/clockTime"}}},
      {"type": "object", "required": ["op"], "additionalProperties": false, "properties": {"op": {"const": "mark_done"}}},
      {"type": "object", "required": ["op", "run_key"], "additionalProperties": false, "properties": {"op": {"const": "list_reminders"}, "run_key": {"$ref": "#/$defs/id"}}},
      {"type": "object", "required": ["op", "kind", "fire_at", "now"], "additionalProperties": false, "properties": {"op": {"const": "is_stale"}, "kind": {"$ref": "#/$defs/id"}, "fire_at": {"$ref": "#/$defs/instant"}, "now": {"$ref": "#/$defs/instant"}}}
    ]},
    "result_add_fixed": {"$ref": "#/$defs/id"},
    "result_create_run": {"$ref": "#/$defs/id"},
    "result_materialise": {"$ref": "#/$defs/strings"},
    "result_set_status": {"$ref": "#/$defs/status"},
    "result_set_clock": {"$ref": "#/$defs/instant"},
    "result_reminder_specs": {"type": "array", "items": {"type": "object", "required": ["kind", "fire_at"], "additionalProperties": false, "properties": {"kind": {"$ref": "#/$defs/reminderKind"}, "fire_at": {"$ref": "#/$defs/instant"}}}},
    "result_ensure_reminders": {"type": "array", "items": {"$ref": "#/$defs/reminderKind"}},
    "result_add_reminder": {"$ref": "#/$defs/nullableId"},
    "result_mark_reminder_sent": {"type": "null"},
    "result_reschedule_unposted_reminder": {"type": "boolean"},
    "result_reconcile_day_of": {"type": "integer", "minimum": 0},
    "result_mark_done": {"$ref": "#/$defs/strings"},
    "result_is_stale": {"type": "boolean"},
    "result_list_reminders": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "fire_at", "sent_at", "message_id"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/reminderKind"}, "fire_at": {"$ref": "#/$defs/instant"}, "sent_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "message_id": {"$ref": "#/$defs/nullableId"}}}},
    "stepResult": {"oneOf": [
      {"type": "object", "required": ["value"], "additionalProperties": false, "properties": {"value": {"anyOf": [
        {"$ref": "#/$defs/result_add_fixed"}, {"$ref": "#/$defs/result_create_run"}, {"$ref": "#/$defs/result_materialise"},
        {"$ref": "#/$defs/result_set_status"}, {"$ref": "#/$defs/result_set_clock"}, {"$ref": "#/$defs/result_reminder_specs"},
        {"$ref": "#/$defs/result_ensure_reminders"}, {"$ref": "#/$defs/result_add_reminder"}, {"$ref": "#/$defs/result_mark_reminder_sent"},
        {"$ref": "#/$defs/result_reschedule_unposted_reminder"}, {"$ref": "#/$defs/result_reconcile_day_of"}, {"$ref": "#/$defs/result_mark_done"},
        {"$ref": "#/$defs/result_is_stale"}, {"$ref": "#/$defs/result_list_reminders"}
      ]}}},
      {"type": "object", "required": ["error"], "additionalProperties": false, "properties": {"error": {"type": "object", "required": ["type", "message"], "additionalProperties": false, "properties": {"type": {"const": "ValueError"}, "message": {"type": "string", "minLength": 1}}}}}
    ]},
    "fixedRow": {"type": "object", "required": ["id", "owner_id", "channel_id", "bosses", "weekday", "time", "participants", "note"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"}, "channel_id": {"$ref": "#/$defs/nullableId"}, "bosses": {"$ref": "#/$defs/strings"}, "weekday": {"type": "integer", "minimum": 0, "maximum": 6}, "time": {"$ref": "#/$defs/hhmm"}, "participants": {"$ref": "#/$defs/strings"}, "note": {"type": ["string", "null"]}}},
    "runRow": {"type": "object", "required": ["id", "fixed_run_id", "channel_id", "bosses", "participants", "status", "source", "week_start", "datetime"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "fixed_run_id": {"$ref": "#/$defs/nullableId"}, "channel_id": {"$ref": "#/$defs/nullableId"}, "bosses": {"$ref": "#/$defs/strings"}, "participants": {"$ref": "#/$defs/strings"}, "status": {"$ref": "#/$defs/status"}, "source": {"$ref": "#/$defs/runSource"}, "week_start": {"$ref": "#/$defs/instant"}, "datetime": {"$ref": "#/$defs/instant"}}},
    "reminderRow": {"type": "object", "required": ["id", "run_id", "kind", "fire_at", "sent_at", "message_id"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/reminderKind"}, "fire_at": {"$ref": "#/$defs/instant"}, "sent_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]}, "message_id": {"$ref": "#/$defs/nullableId"}}},
    "rsvpRow": {"type": "object", "required": ["run_id", "user_id", "state", "source", "at"], "additionalProperties": false, "properties": {"run_id": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "state": {"$ref": "#/$defs/rsvpState"}, "source": {"$ref": "#/$defs/rsvpSource"}, "at": {"$ref": "#/$defs/instant"}}},
    "expected": {"type": "object", "required": ["steps", "final_state"], "additionalProperties": false, "properties": {
      "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stepResult"}},
      "final_state": {"type": "object", "required": ["fixed_runs", "runs", "reminders", "rsvps", "side_effects"], "additionalProperties": false, "properties": {
        "fixed_runs": {"type": "array", "items": {"$ref": "#/$defs/fixedRow"}},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/runRow"}},
        "reminders": {"type": "array", "items": {"$ref": "#/$defs/reminderRow"}},
        "rsvps": {"type": "array", "items": {"$ref": "#/$defs/rsvpRow"}},
        "side_effects": {"type": "array", "maxItems": 0}
      }}
    }}
  }
}
