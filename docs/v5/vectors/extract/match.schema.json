          "type": "boolean"
        },
        "candidate_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "matched": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        }
