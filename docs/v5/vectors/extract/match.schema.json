{
  "$defs": {
    "amendment": {
      "additionalProperties": false,
      "properties": {
        "bosses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "day_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_message_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "is_question": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "move",
            "add",
            "cancel",
            "split",
            "otot",
            "sub",
            "rsvp",
            "fix"
          ]
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rsvp": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "maybe"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "target_run_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "bosses",
        "day_ref",
        "time_ref",
        "participants",
        "rsvp",
        "is_question",
        "confidence",
        "evidence_message_ids",
        "target_run_hint"
      ],
      "type": "object"
    },
    "case": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "input": {
          "$ref": "#/$defs/input"
        }
      },
      "required": [
        "case_id",
        "input",
        "expected"
      ],
      "type": "object"
    },
    "expected": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/outcome"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    },
    "input": {
      "additionalProperties": false,
      "properties": {
        "runs": {
          "items": {
            "$ref": "#/$defs/run"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "type": "array"
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "timezone",
        "runs",
        "steps"
      ],
      "type": "object"
    },
    "outcome": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "value": {}
          },
          "required": [
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "replayCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/input"
        }
      },
      "required": [
        "case_id",
        "input"
      ],
      "type": "object"
    },
    "result_match_run": {
