      "required": [
        "op",
        "amendment",
        "channel_runs",
        "guild_runs",
        "author_id",
        "mentioned"
      ],
      "type": "object"
    },
    "step_needs_run": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "move",
            "add",
            "cancel",
            "split",
            "otot",
            "sub",
            "rsvp",
            "fix"
