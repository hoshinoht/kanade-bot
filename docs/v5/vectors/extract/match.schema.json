        "author_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel_runs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "guild_runs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mentioned": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "op": {
          "const": "match_run"
