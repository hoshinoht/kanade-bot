              "type": "null"
            }
          ]
        },
        "op": {
          "const": "reachable"
        },
        "runs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "runs",
        "day"
      ],
      "type": "object"
    },
    "step_runs_spanned": {
      "additionalProperties": false,
      "properties": {
        "amendment": {
          "$ref": "#/$defs/amendment"
        },
        "author_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel_runs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "op": {
