    "result_needs_run": {
      "type": "boolean"
    },
    "result_reachable": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result_runs_spanned": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
