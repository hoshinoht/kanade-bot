        },
        {
          "$ref": "#/$defs/step_reachable"
        },
        {
          "$ref": "#/$defs/step_needs_run"
        }
      ]
    },
    "step_match_run": {
      "additionalProperties": false,
      "properties": {
        "amendment": {
