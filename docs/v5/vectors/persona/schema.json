{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5 persona prompt-assembly oracle vectors",
  "type": "object",
  "required": ["schema_version", "family", "provenance", "bundles", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v5-persona-v1"},
    "family": {"const": "persona"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "bundles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bundle"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"},
    "text": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "provenance": {
      "type": "object",
      "required": ["oracle", "functions", "templates", "source_tests", "inventory_surfaces"],
      "additionalProperties": false,
      "properties": {
        "oracle": {"$ref": "#/$defs/text"},
        "functions": {"$ref": "#/$defs/strings"},
        "templates": {"$ref": "#/$defs/strings"},
        "source_tests": {"$ref": "#/$defs/strings"},
        "inventory_surfaces": {"$ref": "#/$defs/strings"}
      }
    },
    "staging": {
      "type": "object",
      "required": ["schedule", "guide", "guide_named", "write", "generic"],
      "additionalProperties": false,
      "properties": {
        "schedule": {"$ref": "#/$defs/text"},
        "guide": {"$ref": "#/$defs/text"},
        "guide_named": {"$ref": "#/$defs/text"},
        "write": {"$ref": "#/$defs/text"},
        "generic": {"$ref": "#/$defs/text"}
      }
    },
    "partialStaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {"$ref": "#/$defs/text"},
        "guide": {"$ref": "#/$defs/text"},
        "guide_named": {"$ref": "#/$defs/text"},
        "write": {"$ref": "#/$defs/text"},
        "generic": {"$ref": "#/$defs/text"}
      }
    },
    "bundle": {
      "description": "Raw public v4 template text; the tracked v5 bundle must carry it byte-for-byte.",
      "type": "object",
      "required": ["id", "identity", "behaviour_prompt", "staging"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "identity": {"$ref": "#/$defs/text"},
        "behaviour_prompt": {"$ref": "#/$defs/text"},
        "staging": {"$ref": "#/$defs/staging"}
      }
    },
    "profile": {
      "description": "Synthetic v4 reply-profile Markdown plus optional partial staging.",
      "type": "object",
      "required": ["id", "markdown", "staging"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "markdown": {"$ref": "#/$defs/text"},
        "staging": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/partialStaging"}]}
      }
    },
    "input": {
      "type": "object",
      "required": ["bundle_id", "profile", "clock", "model", "focus_card"],
      "additionalProperties": false,
      "properties": {
        "bundle_id": {"$ref": "#/$defs/slug"},
        "profile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/profile"}]},
        "clock": {
          "type": "object",
          "required": ["now", "timezone", "week_start"],
          "additionalProperties": false,
          "properties": {
            "now": {"type": "string", "format": "date-time"},
            "timezone": {"$ref": "#/$defs/text"},
            "week_start": {"type": "string", "format": "date-time"}
          }
        },
        "model": {"type": "string"},
        "focus_card": {"type": "string"}
      }
    },
    "expected": {
      "type": "object",
      "required": ["header", "runtime", "focus", "system_prompt", "voice_reminder", "staging"],
      "additionalProperties": false,
      "properties": {
        "header": {"$ref": "#/$defs/text"},
        "runtime": {"$ref": "#/$defs/text"},
        "focus": {"type": "string"},
        "system_prompt": {"$ref": "#/$defs/text"},
        "voice_reminder": {"$ref": "#/$defs/text"},
        "staging": {"$ref": "#/$defs/staging"}
      }
    },
    "case": {
      "type": "object",
      "required": ["case_id", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"$ref": "#/$defs/slug"},
        "input": {"$ref": "#/$defs/input"},
        "expected": {"$ref": "#/$defs/expected"}
      }
    }
  }
}
