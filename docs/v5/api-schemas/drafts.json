{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanade.invalid/api-schemas/drafts.json",
  "title": "Admin drafts: staged schedule changes, their preview and conflicts",
  "$defs": {
    "DraftStatus": { "enum": ["open", "merged", "discarded", "expired"] },
    "DraftRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "short_id", "title", "titled", "status", "version", "base", "up_to_date", "scope",
        "week", "staged", "author", "created_at", "updated_at", "merged_seq", "closed_by",
        "close_reason"
      ],
      "properties": {
        "id": { "type": "string" },
        "short_id": { "type": "string" },
        "title": { "type": "string", "description": "The admin's title, or one derived from the staged changes when `titled` is false." },
        "titled": { "type": "boolean" },
        "status": { "$ref": "#/$defs/DraftStatus" },
        "version": { "type": "integer", "minimum": 1, "description": "The precondition every write sends back." },
        "base": { "type": "integer", "minimum": 0, "description": "The History record the draft is based on." },
        "up_to_date": { "type": "boolean", "description": "Based on the current head (`Up to date`); else `Base moved`." },
        "scope": { "enum": ["week", "weekly"] },
        "week": { "$ref": "common.json#/$defs/NullableString", "description": "A week-scoped draft's boss week (first day, guild date)." },
        "staged": { "type": "integer", "minimum": 0 },
        "author": { "$ref": "inbox.json#/$defs/Decider" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "merged_seq": { "type": ["integer", "null"], "minimum": 0 },
        "closed_by": { "anyOf": [{ "$ref": "inbox.json#/$defs/Decider" }, { "type": "null" }] },
        "close_reason": { "$ref": "common.json#/$defs/NullableString" }
      }
    },
    "DraftList": {
      "type": "object",
      "additionalProperties": false,
      "description": "`GET /api/admin/drafts?state=open|closed`: the signed-in admin's own drafts, most recently changed first.",
      "required": ["head", "drafts"],
      "properties": {
        "head": { "type": "integer", "minimum": 0 },
        "drafts": { "type": "array", "items": { "$ref": "#/$defs/DraftRow" } }
      }
    },
    "StagedOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ord", "kind", "summary", "run_id", "fixed_id", "created_by", "author", "added_at"],
      "properties": {
        "ord": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "description": "The operation's codec kind (`amend_run`, `set_status`, `swap_participants`, `reset_to_fixed`, `fixed_participants`, `apply_fixed_edit`, ...)." },
        "summary": { "type": "string" },
        "run_id": { "$ref": "common.json#/$defs/NullableString" },
        "fixed_id": { "$ref": "common.json#/$defs/NullableString" },
        "created_by": { "type": ["integer", "null"], "minimum": 0, "description": "The earlier change that creates the row this one acts on." },
        "author": { "$ref": "inbox.json#/$defs/Decider" },
        "added_at": { "type": "string" }
      }
    },
    "DraftDetail": {
      "type": "object",
      "additionalProperties": false,
      "description": "`GET /api/admin/drafts/{id}`: the row plus its staged changes in order.",
      "required": [
        "id", "short_id", "title", "titled", "status", "version", "base", "up_to_date", "scope",
        "week", "staged", "author", "created_at", "updated_at", "merged_seq", "closed_by",
        "close_reason", "ops"
      ],
      "properties": {
        "id": { "type": "string" },
        "short_id": { "type": "string" },
        "title": { "type": "string" },
        "titled": { "type": "boolean" },
        "status": { "$ref": "#/$defs/DraftStatus" },
        "version": { "type": "integer", "minimum": 1 },
        "base": { "type": "integer", "minimum": 0 },
        "up_to_date": { "type": "boolean" },
        "scope": { "enum": ["week", "weekly"] },
        "week": { "$ref": "common.json#/$defs/NullableString" },
        "staged": { "type": "integer", "minimum": 0 },
        "author": { "$ref": "inbox.json#/$defs/Decider" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "merged_seq": { "type": ["integer", "null"], "minimum": 0 },
        "closed_by": { "anyOf": [{ "$ref": "inbox.json#/$defs/Decider" }, { "type": "null" }] },
        "close_reason": { "$ref": "common.json#/$defs/NullableString" },
        "ops": { "type": "array", "items": { "$ref": "#/$defs/StagedOp" } }
      }
    },
    "ConflictRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "The latest History record after the draft's base that touched the conflicting row.",
      "required": ["seq", "actor", "at"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "actor": { "$ref": "inbox.json#/$defs/Decider" },
        "at": { "type": "string" }
      }
    },
    "DraftConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "run_id", "fixed_id", "field", "base", "yours", "now", "removal", "message", "ops", "settle", "record"],
      "properties": {
        "key": { "type": "string", "description": "What `POST …/rebase` names it by in `settle`." },
        "kind": { "enum": ["both_changed", "upstream_removed", "op_rejected", "choices_stale", "stale_weeks", "divergent"] },
        "run_id": { "$ref": "common.json#/$defs/NullableString" },
        "fixed_id": { "$ref": "common.json#/$defs/NullableString" },
        "field": { "$ref": "common.json#/$defs/NullableString" },
        "base": { "$ref": "common.json#/$defs/NullableString", "description": "Both changed: the value drafted on." },
        "yours": { "$ref": "common.json#/$defs/NullableString" },
        "now": { "$ref": "common.json#/$defs/NullableString" },
        "removal": { "enum": ["deleted", "retired", "cancelled", "done", "left_run", null] },
        "message": { "type": "string" },
        "ops": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "The staged changes involved (`take` drops them)." },
        "settle": { "type": "array", "items": { "enum": ["keep", "take"] }, "description": "The answers a rebase accepts; `keep` on a cancelled or finished run revives it first." },
        "record": { "anyOf": [{ "$ref": "#/$defs/ConflictRecord" }, { "type": "null" }] }
      }
    },
    "DraftPreview": {
      "type": "object",
      "additionalProperties": false,
      "description": "`GET /api/admin/drafts/{id}/preview`: the rows a merge would write against the current schedule (History's diff rows) and every conflict. Merge is offered only when `mergeable`.",
      "required": ["id", "version", "base", "head", "up_to_date", "mergeable", "rows", "conflicts", "consequence"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "base": { "type": "integer", "minimum": 0 },
        "head": { "type": "integer", "minimum": 0 },
        "up_to_date": { "type": "boolean" },
        "mergeable": { "type": "boolean" },
        "rows": { "type": "array", "items": { "$ref": "history.json#/$defs/RowChange" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/DraftConflict" } },
        "consequence": { "$ref": "common.json#/$defs/NullableString" }
      }
    },
    "DraftWritten": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every draft write's answer (201 for a create); re-read the draft for the rest. Replayed as-is for the same Idempotency-Key.",
      "required": ["id", "version", "status", "seq", "message"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/DraftStatus" },
        "seq": { "type": ["integer", "null"], "minimum": 0, "description": "A merge's History record." },
        "message": { "type": "string" }
      }
    },
    "OpBody": {
      "description": "Body of `POST /api/admin/drafts/{id}/ops` (`{version, op}`). A `run`/`fixed` is a stored id or `created:<n>`.",
      "oneOf": [
        { "type": "object", "required": ["kind", "run", "day"], "properties": { "kind": { "const": "move" }, "run": { "type": "string" }, "day": { "type": "integer", "minimum": 0, "maximum": 6 }, "time": { "$ref": "common.json#/$defs/NullableString" } } },
        { "type": "object", "required": ["kind", "run", "status"], "properties": { "kind": { "const": "status" }, "run": { "type": "string" }, "status": { "type": "string" } } },
        { "type": "object", "required": ["kind", "run"], "properties": { "kind": { "const": "party" }, "run": { "type": "string" }, "add": { "type": "array", "items": { "type": "string" } }, "remove": { "type": "array", "items": { "type": "string" } } } },
        { "type": "object", "required": ["kind", "run"], "properties": { "kind": { "const": "reset" }, "run": { "type": "string" } } },
        { "type": "object", "required": ["kind", "fixed"], "properties": { "kind": { "const": "fixed_party" }, "fixed": { "type": "string" }, "add": { "type": "array", "items": { "type": "string" } }, "remove": { "type": "array", "items": { "type": "string" } } } },
        { "type": "object", "required": ["kind", "fixed", "day", "time"], "properties": { "kind": { "const": "fixed_time" }, "fixed": { "type": "string" }, "day": { "type": "integer", "minimum": 0, "maximum": 6 }, "time": { "type": "string" } } }
      ]
    }
  }
}
