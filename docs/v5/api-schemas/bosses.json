{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanade.invalid/api-schemas/bosses.json",
  "title": "Boss list, knowledge pages (boss/knowledge schema v2) and event bosses",
  "$defs": {
    "DifficultyOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["letter", "name", "token", "in_use"],
      "properties": {
        "letter": { "$ref": "common.json#/$defs/Difficulty" },
        "name": { "type": "string" },
        "token": { "type": "string" },
        "in_use": { "type": "boolean" }
      }
    },
    "BossRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "level", "hue", "portrait", "difficulties"],
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "integer" },
        "hue": { "type": "integer", "minimum": 0, "maximum": 359 },
        "portrait": { "$ref": "common.json#/$defs/NullableString" },
        "difficulties": { "type": "array", "items": { "$ref": "#/$defs/DifficultyOption" } }
      }
    },
    "BossRows": { "type": "array", "items": { "$ref": "#/$defs/BossRow" } },
    "EventInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "availability"],
      "properties": {
        "name": { "type": "string" },
        "availability": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "GuideItem": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "text"],
          "properties": { "title": { "type": "string" }, "text": { "type": "string" }, "detail": { "type": "string" } }
        }
      ]
    },
    "GuideItems": { "type": "array", "items": { "$ref": "#/$defs/GuideItem" } },
    "Mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series", "order", "title"],
      "properties": {
        "series": { "$ref": "#/$defs/MissionSeries" },
        "order": { "type": "integer" },
        "title": { "type": "string" },
        "modifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "direction"],
          "properties": { "text": { "type": "string" }, "direction": { "enum": ["up", "down"] } }
        },
        "needs": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "MissionSeries": { "enum": ["destiny-weapon", "union-champion"] },
    "MissionStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series", "order", "key", "name", "difficulty"],
      "properties": {
        "series": { "$ref": "#/$defs/MissionSeries" },
        "order": { "type": "integer" },
        "key": { "type": "string" },
        "name": { "type": "string" },
        "difficulty": { "enum": ["Easy", "Normal", "Hard", "Chaos", "Extreme", "Champion", "Destiny"] }
      }
    },
    "Mechanic": {
      "description": "Diagram block; shape per kind as in boss/knowledge/schema.json.",
      "type": "object",
      "required": ["kind", "title"],
      "properties": { "kind": { "enum": ["ledger", "zones", "scale"] }, "title": { "type": "string" } }
    },
    "Strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "risk", "damage", "payoff", "steps"],
      "properties": {
        "name": { "type": "string" },
        "when": { "type": "string" },
        "risk": { "enum": ["low", "medium", "high"] },
        "damage": { "enum": ["low", "medium", "high"] },
        "payoff": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "DifficultyFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["Easy", "Normal", "Hard", "Chaos", "Extreme", "Champion", "Destiny"] },
        "entry_level": { "type": "integer" },
        "boss_level": { "type": "integer" },
        "pdr_percent": { "type": "number" },
        "party_max": { "type": "integer" },
        "force": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["arcane", "sacred"] },
            "value": { "type": "number" }
          }
        },
        "hp": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "value"],
            "properties": {
              "phase": { "type": "string" },
              "value": { "type": "string" },
              "count": { "type": "integer" }
            }
          }
        },
        "recommended_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "type": "string" },
            "text": { "type": "string" },
            "value": { "type": "string" },
            "basis": { "type": "string" }
          }
        },
        "notes": { "$ref": "#/$defs/GuideItems" },
        "mission": { "$ref": "#/$defs/Mission" }
      }
    },
    "KnowledgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "author", "kind", "fetched"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "kind": { "enum": ["guide", "wiki", "tool", "official"] },
        "fetched": { "type": "string" },
        "updated": { "type": "string" }
      }
    },
    "KnowledgeDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boss", "summary", "danger", "tips", "sources"],
      "properties": {
        "boss": { "type": "string" },
        "summary": { "type": "string" },
        "lead": { "type": "string" },
        "core": { "$ref": "#/$defs/GuideItems" },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "items"],
            "properties": { "name": { "type": "string" }, "items": { "$ref": "#/$defs/GuideItems" } }
          }
        },
        "danger": { "$ref": "#/$defs/GuideItems" },
        "tips": { "$ref": "#/$defs/GuideItems" },
        "difficulty_notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "e": { "$ref": "#/$defs/GuideItem" },
            "n": { "$ref": "#/$defs/GuideItem" },
            "h": { "$ref": "#/$defs/GuideItem" },
            "c": { "$ref": "#/$defs/GuideItem" },
            "x": { "$ref": "#/$defs/GuideItem" }
          }
        },
        "notes": { "$ref": "#/$defs/GuideItems" },
        "mechanics": { "type": "array", "items": { "$ref": "#/$defs/Mechanic" } },
        "event": { "$ref": "#/$defs/EventInfo" },
        "difficulties": { "type": "array", "items": { "$ref": "#/$defs/DifficultyFacts" } },
        "strategies": { "type": "array", "items": { "$ref": "#/$defs/Strategy" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/KnowledgeSource" } }
      }
    },
    "Knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "level", "portrait", "animated", "hue", "researched_as_of", "path", "in_use", "doc", "missions"],
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": ["integer", "null"] },
        "portrait": { "$ref": "common.json#/$defs/NullableString" },
        "animated": { "$ref": "common.json#/$defs/NullableString" },
        "hue": { "type": "integer", "minimum": 0, "maximum": 359 },
        "researched_as_of": { "$ref": "common.json#/$defs/NullableString" },
        "path": { "type": "string" },
        "in_use": { "type": "array", "items": { "$ref": "common.json#/$defs/Difficulty" } },
        "doc": { "$ref": "#/$defs/KnowledgeDoc" },
        "missions": { "type": "array", "items": { "$ref": "#/$defs/MissionStop" } }
      }
    },
    "EventBoss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "event", "summary", "portrait", "portrait_sm", "art", "animated"],
      "properties": {
        "key": { "type": "string" },
        "event": { "$ref": "#/$defs/EventInfo" },
        "summary": { "type": "string" },
        "portrait": { "$ref": "common.json#/$defs/NullableString" },
        "portrait_sm": { "$ref": "common.json#/$defs/NullableString" },
        "art": { "$ref": "common.json#/$defs/NullableString" },
        "animated": { "$ref": "common.json#/$defs/NullableString" }
      }
    },
    "EventBosses": { "type": "array", "items": { "$ref": "#/$defs/EventBoss" } }
  }
}
