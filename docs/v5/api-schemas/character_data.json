{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanade.invalid/api-schemas/character_data.json",
  "title": "Character data (module character_data): NEXON Open API data for linked roster characters",
  "$defs": {
    "CharacterLink": {
      "description": "One roster character's link and its fresh Nexon data. The ocid is never sent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "state", "version", "connected", "requested_by", "requested_at", "consent_version", "consented_at", "linked_at", "notice_version", "data", "refresh", "attribution", "privacy_url"],
      "properties": {
        "character_id": { "type": "string" },
        "state": {
          "enum": ["not_connected", "not_linked", "pending", "linked", "stale", "expired"],
          "description": "not_connected: no Nexon key is configured and no link exists; pending: an admin asked and the member has not confirmed (no call made); stale: the character could not be resolved or changed its name (link again); expired: linked, but the data passed its 30 days."
        },
        "version": { "type": "integer", "minimum": 0, "description": "The link version; send it back with a link request (0 while there is no link)." },
        "connected": { "type": "boolean", "description": "A Nexon key is configured." },
        "requested_by": { "oneOf": [{ "$ref": "history.json#/$defs/Actor" }, { "type": "null" }] },
        "requested_at": { "$ref": "common.json#/$defs/NullableString" },
        "consent_version": { "type": ["integer", "null"], "minimum": 1, "description": "The notice version the member confirmed." },
        "consented_at": { "$ref": "common.json#/$defs/NullableString" },
        "linked_at": { "$ref": "common.json#/$defs/NullableString" },
        "notice_version": { "type": "integer", "minimum": 1, "description": "The current notice version." },
        "data": { "oneOf": [{ "$ref": "#/$defs/CharacterFacts" }, { "type": "null" }], "description": "Fresh Nexon data; null without any (never expired or stamped in the future)." },
        "refresh": { "$ref": "#/$defs/RefreshInfo" },
        "attribution": { "const": "Data based on NEXON Open API" },
        "privacy_url": { "$ref": "common.json#/$defs/NullableString", "description": "The public /privacy page; null without a public listener." }
      }
    },
    "CharacterFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "world", "class", "level", "combat_power", "image_url", "as_of", "fetched_at", "expires_at"],
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 64 },
        "world": { "type": ["string", "null"], "maxLength": 64 },
        "class": { "type": ["string", "null"], "maxLength": 64 },
        "level": { "type": ["integer", "null"], "minimum": 0 },
        "combat_power": { "type": ["integer", "null"], "minimum": 0 },
        "image_url": { "type": ["string", "null"], "pattern": "^https://", "description": "Hotlinked from Nexon, never re-hosted." },
        "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Singapore date: the response date, else the fetch day." },
        "fetched_at": { "type": "string" },
        "expires_at": { "type": "string", "description": "Deleted then unless refreshed (30 days)." }
      }
    },
    "RefreshInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_attempt_at", "last_error"],
      "properties": {
        "next_attempt_at": { "$ref": "common.json#/$defs/NullableString" },
        "last_error": { "$ref": "common.json#/$defs/NullableString", "description": "The Open API error code (OPENAPI000NN) or reason (budget, maintenance, key_refused, unavailable, http_NNN) that stopped the last refresh." }
      }
    },
    "LinkRequest": {
      "description": "POST /api/admin/characters/{id}/link body.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "integer", "minimum": 0, "description": "The link version as loaded (0 when not linked)." }
      }
    },
    "RunReadiness": {
      "description": "GET /api/admin/runs/{id}/readiness: each party slot (as GET .../characters reads them, inferred recomputed) with its level and power, and its level against each boss of the run. Computed on read, never stored, never blocking. NEXON values only from an active link's unexpired data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "slots", "nexon_data", "attribution"],
      "properties": {
        "run_id": { "type": "string" },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/ReadinessSlot" }, "description": "In party order." },
        "nexon_data": { "type": "boolean", "description": "Some slot shows a NEXON value: show the attribution." },
        "attribution": { "const": "Data based on NEXON Open API" }
      }
    },
    "ReadinessSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "character", "inferred", "link", "level", "power", "bosses"],
      "properties": {
        "member_id": { "type": "string" },
        "character": {
          "description": "The character the member brings (picked, else the only candidate); null with none.",
          "oneOf": [{ "$ref": "characters.json#/$defs/CharacterChoice" }, { "type": "null" }]
        },
        "inferred": { "type": "boolean", "description": "The character is the only candidate, not a pick." },
        "link": { "enum": ["not_connected", "not_linked", "pending", "linked", "stale", "expired", null], "description": "The character's link as the strip shows it; null without a character." },
        "level": {
          "description": "Fresh NEXON level, else the manual roster level; null with neither.",
          "oneOf": [{ "$ref": "#/$defs/ReadinessLevel" }, { "type": "null" }]
        },
        "power": {
          "description": "Shown, never judged. Null without usable data.",
          "oneOf": [{ "$ref": "#/$defs/ReadinessPower" }, { "type": "null" }]
        },
        "bosses": { "type": "array", "items": { "$ref": "#/$defs/BossReadiness" }, "description": "One per boss of the run, in run order." }
      }
    },
    "ReadinessLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "as_of"],
      "properties": {
        "value": { "type": "integer", "minimum": 1 },
        "source": { "enum": ["nexon", "manual"] },
        "as_of": { "type": ["string", "null"], "format": "date", "description": "YYYY-MM-DD (Singapore): the NEXON response date, else its fetch day; null for a manual level." }
      }
    },
    "ReadinessPower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "as_of"],
      "properties": {
        "kind": { "enum": ["nexon_cp", "scouter"], "description": "scouter is reserved for MapleScouter's boss values (not sent yet)." },
        "value": { "type": "integer", "minimum": 0 },
        "as_of": { "type": ["string", "null"], "format": "date" }
      }
    },
    "BossReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boss", "difficulty", "entry_level", "level"],
      "properties": {
        "boss": { "type": "string", "description": "Catalog boss key." },
        "difficulty": { "enum": ["e", "n", "h", "c", "x"] },
        "entry_level": { "type": ["integer", "null"], "minimum": 1, "description": "From boss knowledge; null when it has none." },
        "level": { "enum": ["ok", "under", "unknown"], "description": "ok at or above entry_level; unknown without a level or an entry_level." }
      }
    },
    "CharacterDataHealth": {
      "description": "Config's module health block (informational, never part of /healthz).",
      "type": "object",
      "additionalProperties": false,
      "required": ["nexon", "backoff_until", "calls_24h", "budget", "last_batch", "links", "last_sweep", "posts", "scouter"],
      "properties": {
        "nexon": { "enum": ["no_key", "ok", "backoff", "key_refused"] },
        "backoff_until": { "$ref": "common.json#/$defs/NullableString" },
        "calls_24h": { "type": ["integer", "null"], "minimum": 0 },
        "budget": { "type": "integer", "minimum": 1 },
        "last_batch": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "refreshed", "failed", "stopped"],
              "properties": {
                "at": { "type": "string" },
                "refreshed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "stopped": { "$ref": "common.json#/$defs/NullableString" }
              }
            },
            { "type": "null" }
          ]
        },
        "links": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["pending", "active", "stale"],
              "properties": {
                "pending": { "type": "integer", "minimum": 0 },
                "active": { "type": "integer", "minimum": 0 },
                "stale": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        },
        "last_sweep": { "$ref": "common.json#/$defs/NullableString" },
        "posts": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["due", "unknown", "stuck", "overdue", "items"],
              "properties": {
                "due": { "type": "integer", "minimum": 0 },
                "unknown": { "type": "integer", "minimum": 0 },
                "stuck": { "type": "integer", "minimum": 0 },
                "overdue": { "type": "integer", "minimum": 0 },
                "items": {
                  "description": "The share cards behind unknown, stuck and overdue, oldest first: ids and states only.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["reference", "state", "channel_id", "posted_at", "jump_url"],
                    "properties": {
                      "reference": { "type": "string", "pattern": "^[0-9a-f]{6}$" },
                      "state": { "enum": ["unknown", "stuck", "overdue"] },
                      "channel_id": { "type": "string" },
                      "posted_at": { "type": "string" },
                      "jump_url": { "$ref": "common.json#/$defs/NullableString" }
                    }
                  }
                }
              }
            },
            { "type": "null" }
          ]
        },
        "scouter": { "$ref": "#/$defs/ScouterHealth" }
      }
    },
    "ScouterHealth": {
      "description": "MapleScouter estimates: off without KANADE_SCOUTER_URL; verification_required stays until a lookup succeeds again.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "url", "last_lookup_at", "last_error", "last_error_at"],
      "properties": {
        "state": { "enum": ["off", "ok", "unreachable", "verification_required"] },
        "url": { "type": ["string", "null"], "pattern": "^http://", "description": "The sidecar's http://host[:port]; null while off." },
        "last_lookup_at": { "$ref": "common.json#/$defs/NullableString" },
        "last_error": { "$ref": "common.json#/$defs/NullableString", "description": "MapleScouter's error code (busy, upstream_rate_limited, critical_rate_setup_required, verification_required, upstream_blocked, lookup_failed, result_mismatch, extraction_failed, lookup_timeout, …) or timeout, unreachable, unreadable." },
        "last_error_at": { "$ref": "common.json#/$defs/NullableString" }
      }
    },
    "EstimateRequest": {
      "description": "POST /api/admin/estimates body: exactly one of character_ids (1 to 6) or run_id; refresh skips the 24-hour memory (Look up again).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character_ids": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
        "run_id": { "type": "string", "minLength": 1 },
        "refresh": { "type": "boolean" }
      },
      "oneOf": [{ "required": ["character_ids"] }, { "required": ["run_id"] }]
    },
    "EstimateStarted": {
      "description": "202 answer to POST /api/admin/estimates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job"],
      "properties": { "job": { "$ref": "#/$defs/EstimateJob" } }
    },
    "EstimateStatus": {
      "description": "GET /api/admin/estimates?character_ids=|run_id=: that target's job (one retained per target for 24 hours; a new lookup of the same target replaces it) and the job running now, whatever it looks up.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job", "running"],
      "properties": {
        "job": { "oneOf": [{ "$ref": "#/$defs/EstimateJob" }, { "type": "null" }] },
        "running": { "oneOf": [{ "$ref": "#/$defs/EstimateJob" }, { "type": "null" }] }
      }
    },
    "EstimateJob": {
      "description": "One MapleScouter lookup (admin only). MapleScouter is sent roster IGNs only, never a Nexon field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "run_id", "character_ids", "started_by", "started_at", "finished_at", "characters", "missing", "progress", "fetched_at", "result", "error", "label", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["running", "done", "failed"] },
        "run_id": { "$ref": "common.json#/$defs/NullableString", "description": "A run's party; null for a character lookup." },
        "character_ids": { "type": "array", "items": { "type": "string" }, "description": "The characters asked for (sorted); empty for a run." },
        "started_by": { "$ref": "history.json#/$defs/Actor" },
        "started_at": { "type": "string" },
        "finished_at": { "$ref": "common.json#/$defs/NullableString" },
        "characters": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["character_id", "member_id", "ign"],
            "properties": {
              "character_id": { "type": "string" },
              "member_id": { "type": "string" },
              "ign": { "type": "string", "pattern": "^[A-Za-z0-9]{1,32}$", "description": "The roster IGN, as sent to MapleScouter." }
            }
          }
        },
        "missing": {
          "type": "array",
          "description": "Party members not looked up: listed as missing, never 0%.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member_id", "character_id", "reason"],
            "properties": {
              "member_id": { "type": "string" },
              "character_id": { "$ref": "common.json#/$defs/NullableString" },
              "reason": { "enum": ["no_characters", "no_character_picked", "other_region", "unsupported_ign"] }
            }
          }
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["done", "total", "current"],
          "properties": {
            "done": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 1, "maximum": 6 },
            "current": { "$ref": "common.json#/$defs/NullableString", "description": "The character being looked up now; null between characters, for the party total and once finished." }
          }
        },
        "fetched_at": { "$ref": "common.json#/$defs/NullableString", "description": "When the result came from MapleScouter (a cached answer keeps its first time)." },
        "result": { "oneOf": [{ "$ref": "#/$defs/EstimateResult" }, { "type": "null" }] },
        "error": { "oneOf": [{ "$ref": "#/$defs/EstimateError" }, { "type": "null" }] },
        "label": { "const": "Estimate from MapleScouter" },
        "note": { "const": "Estimate for planning only, not eligibility" }
      }
    },
    "EstimateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_hit", "complete", "members", "combined"],
      "properties": {
        "cache_hit": { "type": "boolean", "description": "Answered from kanade's 24-hour memory (never persisted) without calling MapleScouter." },
        "complete": { "type": "boolean", "description": "No party member missing and every total complete." },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["character_id", "ign", "preset", "bosses"],
            "properties": {
              "character_id": { "type": "string" },
              "ign": { "type": "string" },
              "preset": { "type": "string", "pattern": "^[0-9]{5}$" },
              "bosses": {
                "type": "array",
                "description": "Catalog bosses only, in catalog order.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["boss", "percentage", "effective_percentage", "estimated_minutes", "rating", "party"],
                  "properties": {
                    "boss": { "type": "string", "description": "Catalog token, e.g. HLimbo." },
                    "percentage": { "type": "number" },
                    "effective_percentage": { "type": ["number", "null"] },
                    "estimated_minutes": { "type": ["number", "null"] },
                    "rating": { "type": "string" },
                    "party": { "type": "boolean" }
                  }
                }
              }
            }
          }
        },
        "combined": {
          "description": "Party totals (a run's bosses, or every catalog boss for several characters); null for one character.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["boss", "combined_percentage", "estimated_minutes", "technically_possible", "complete", "issues"],
                "properties": {
                  "boss": { "type": "string" },
                  "combined_percentage": { "type": ["number", "null"] },
                  "estimated_minutes": { "type": ["number", "null"] },
                  "technically_possible": { "type": ["boolean", "null"] },
                  "complete": { "type": "boolean" },
                  "issues": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["character_id", "issue"],
                      "properties": {
                        "character_id": { "$ref": "common.json#/$defs/NullableString" },
                        "issue": { "enum": ["missing_boss", "unknown_benchmark_players", "not_covered", "other"] }
                      }
                    }
                  }
                }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "EstimateError": {
      "description": "The drawn error states. No total is made from a partial lookup.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "status", "detail", "retry_after_seconds", "character_id"],
      "properties": {
        "code": { "enum": ["busy", "critical_rate", "manual_check", "failed"] },
        "message": { "enum": ["MapleScouter is busy.", "Set up critical rate on MapleScouter first.", "Scouter needs a manual check.", "Lookup failed."] },
        "status": { "type": ["integer", "null"], "description": "MapleScouter's HTTP status (429, 422, 503, 502, 504); null without an answer." },
        "detail": { "type": "string", "description": "MapleScouter's error code, or timeout, unreachable, unreadable." },
        "retry_after_seconds": { "type": ["integer", "null"], "minimum": 0, "description": "429 only: Retry-After." },
        "character_id": { "$ref": "common.json#/$defs/NullableString", "description": "The character it stopped at, when known." }
      }
    }
  }
}
