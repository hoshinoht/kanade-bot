{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanade.invalid/api-schemas/history.json",
  "title": "History (kanade.change.v1, docs/v5/history.md): pages, records, rollback plans, checkpoints, blame",
  "$defs": {
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "$ref": "common.json#/$defs/ActorKind" },
        "id": { "type": "string" }
      }
    },
    "RowKey": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "id"],
          "properties": {
            "table": { "enum": ["runs", "fixed_runs", "reminders"] },
            "id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "run_id", "user_id"],
          "properties": {
            "table": { "const": "rsvps" },
            "run_id": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      ]
    },
    "DomainRow": { "type": ["object", "null"], "description": "Full domain row; null = absent." },
    "RowChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "before", "after"],
      "properties": {
        "key": { "$ref": "#/$defs/RowKey" },
        "before": { "$ref": "#/$defs/DomainRow" },
        "after": { "$ref": "#/$defs/DomainRow" }
      }
    },
    "ChangeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "seq", "id", "revision", "at", "actor", "surface", "request_id", "weeks", "rows", "notices", "refs", "prev_hash", "hash"],
      "properties": {
        "format": { "const": "kanade.change.v1" },
        "seq": { "type": "integer", "minimum": 0 },
        "id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "at": { "type": "string" },
        "actor": { "$ref": "#/$defs/Actor" },
        "surface": { "$ref": "common.json#/$defs/Surface" },
        "request_id": { "$ref": "common.json#/$defs/NullableString" },
        "weeks": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/RowChange" } },
        "notices": { "type": "array", "items": { "type": "string" } },
        "refs": { "type": "array", "items": { "$ref": "common.json#/$defs/Head" } },
        "prev_hash": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "HistoryPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "head", "next_before", "total"],
      "properties": {
        "records": { "type": "array", "items": { "$ref": "#/$defs/ChangeRecord" } },
        "head": { "$ref": "common.json#/$defs/Head" },
        "next_before": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "RevertPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reverts", "rows", "conflicts", "skipped", "record"],
      "properties": {
        "outcome": { "enum": ["preview", "applied", "unchanged", "conflicts"] },
        "reverts": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/RowChange" } },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "key", "expected", "found"],
            "properties": {
              "seq": { "type": "integer", "minimum": 0 },
              "key": { "$ref": "#/$defs/RowKey" },
              "expected": {},
              "found": {}
            }
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "reason"],
            "properties": {
              "key": { "$ref": "#/$defs/RowKey" },
              "reason": { "type": "string" }
            }
          }
        },
        "record": {
          "anyOf": [{ "$ref": "#/$defs/ChangeRecord" }, { "type": "null" }]
        }
      }
    },
    "Checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "backups"],
      "properties": {
        "verified": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "checked", "head"],
          "properties": {
            "ok": { "type": "boolean" },
            "checked": { "type": "integer", "minimum": 0 },
            "head": { "$ref": "common.json#/$defs/Head" }
          }
        },
        "backups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "format", "created_at", "history_head", "revision", "schema_version", "anchored"],
            "properties": {
              "file": { "type": "string" },
              "format": { "const": "kanade.backup.v1" },
              "created_at": { "type": "string" },
              "history_head": { "$ref": "common.json#/$defs/Head" },
              "revision": { "type": "integer", "minimum": 0 },
              "schema_version": { "type": "integer", "minimum": 0 },
              "anchored": { "type": "boolean" }
            }
          }
        }
      }
    },
    "BlameEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "seq", "at", "actor", "surface"],
      "properties": {
        "field": {
          "type": "string",
          "description": "Blame's field name (docs/v5/history.md): `slot`, `bosses`, `participants`, `channel`, `status`, `status_pin`, `rsvp:<member id>` per answer, `attended:<member id>` per attendance entry. Fields no record set are not listed."
        },
        "value": { "description": "The field's current value: `slot` is `{datetime, week_start, source, fixed_run_id}`, `channel` the channel id, `rsvp:`/`attended:` the row or entry (null once cleared), the rest as in the run row." },
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "type": "string" },
        "actor": { "$ref": "#/$defs/Actor" },
        "surface": { "$ref": "common.json#/$defs/Surface" }
      }
    },
    "BlameEntries": { "type": "array", "items": { "$ref": "#/$defs/BlameEntry" } }
  }
}
