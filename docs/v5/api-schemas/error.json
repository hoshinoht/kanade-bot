{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanade.invalid/api-schemas/error.json",
  "title": "ApiError: every non-2xx JSON body on both origins",
  "$defs": {
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "message"],
      "properties": {
        "error": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    }
  }
}
