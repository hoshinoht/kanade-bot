{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanade.invalid/api-schemas/week.json",
  "title": "Week board: public and admin projections, run edits, stats and summary",
  "$defs": {
    "LocalTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "RunTime": { "anyOf": [{ "$ref": "#/$defs/LocalTime" }, { "type": "null" }] },
    "PublicRun": {
      "description": "No participants, answers, party or version (personal data / writer tokens).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "day", "time", "status", "bosses", "tally"],
      "properties": {
        "id": { "type": "string" },
        "day": { "type": "integer", "minimum": 0, "maximum": 6 },
        "time": { "$ref": "#/$defs/RunTime" },
        "status": { "$ref": "common.json#/$defs/RunStatus" },
        "bosses": { "$ref": "common.json#/$defs/Bosses" },
        "tally": { "$ref": "common.json#/$defs/Tally" }
      }
    },
    "PublicWeek": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts", "timezone", "reset", "days", "runs", "generated_at"],
      "properties": {
        "starts": { "type": "string" },
        "timezone": { "type": "string" },
        "reset": { "type": "string" },
        "days": { "type": "array", "items": { "$ref": "common.json#/$defs/WeekDay" } },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/PublicRun" } },
        "generated_at": { "type": "string" }
      }
    },
    "Participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "answer"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "answer": { "$ref": "common.json#/$defs/Answer" }
      }
    },
    "ReminderCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "state", "at", "url"],
      "properties": {
        "label": { "$ref": "common.json#/$defs/CardKind" },
        "state": { "enum": ["posted", "queued", "skipped"] },
        "at": { "type": "string" },
        "url": { "$ref": "common.json#/$defs/NullableString" }
      }
    },
    "Run": {
      "description": "PublicRun plus who and where.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "day", "time", "minutes", "status", "bosses", "tally",
        "short_id", "participants", "party", "channel_id", "channel", "cards", "fixed_id", "amended", "roster_change"
      ],
      "properties": {
        "id": { "type": "string" },
        "day": { "type": "integer", "minimum": 0, "maximum": 6 },
        "time": { "$ref": "#/$defs/RunTime" },
        "minutes": { "type": "integer", "minimum": 1, "description": "Configured sum of the run's boss durations, including own-time runs." },
        "status": { "$ref": "common.json#/$defs/RunStatus" },
        "bosses": { "$ref": "common.json#/$defs/Bosses" },
        "tally": { "$ref": "common.json#/$defs/Tally" },
        "short_id": { "type": "string" },
        "participants": { "type": "array", "items": { "$ref": "#/$defs/Participant" } },
        "party": { "type": "string" },
        "channel_id": { "type": "string" },
        "channel": { "type": "string" },
        "cards": { "type": "array", "items": { "$ref": "#/$defs/ReminderCard" } },
        "fixed_id": { "$ref": "common.json#/$defs/NullableString" },
        "amended": { "type": "boolean" },
        "roster_change": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["out", "in"],
              "properties": {
                "out": { "$ref": "common.json#/$defs/Members" },
                "in": { "$ref": "common.json#/$defs/Members" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "Week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts", "timezone", "reset", "days", "runs", "generated_at", "version"],
      "properties": {
        "starts": { "type": "string" },
        "timezone": { "type": "string" },
        "reset": { "type": "string" },
        "days": { "type": "array", "items": { "$ref": "common.json#/$defs/WeekDay" } },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/Run" } },
        "generated_at": { "type": "string" },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "RunResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "version"],
      "properties": {
        "run": { "$ref": "#/$defs/Run" },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "MoveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "previous", "version"],
      "properties": {
        "run": { "$ref": "#/$defs/Run" },
        "previous": {
          "type": "object",
          "additionalProperties": false,
          "required": ["day", "time"],
          "properties": {
            "day": { "type": "integer", "minimum": 0, "maximum": 6 },
            "time": { "$ref": "#/$defs/RunTime" }
          }
        },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "SwapResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "version"],
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/Run" }
        },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "Stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_day"],
      "properties": {
        "per_day": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["day", "answered", "waiting"],
            "properties": {
              "day": { "type": "integer", "minimum": 0, "maximum": 6 },
              "answered": { "type": "integer", "minimum": 0 },
              "waiting": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next", "unanswered", "inbox", "members", "reminders", "model", "quiet_mode", "rescan_off"],
      "properties": {
        "next": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "bosses", "when", "countdown", "on", "total"],
              "properties": {
                "run_id": { "type": "string" },
                "bosses": { "type": "string" },
                "when": { "type": "string" },
                "countdown": { "type": "string" },
                "on": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        },
        "unanswered": { "type": "integer", "minimum": 0 },
        "inbox": { "type": "integer", "minimum": 0 },
        "members": { "type": "integer", "minimum": 0 },
        "reminders": { "type": "integer", "minimum": 0 },
        "model": {
          "description": "Busy when a model-governor group has every permit in use; holder is that group's oldest permit's call kind (chat, extraction, rescan, follow_up, rewrite, pre_screen).",
          "type": "object",
          "additionalProperties": false,
          "required": ["busy", "holder"],
          "properties": {
            "busy": { "type": "boolean" },
            "holder": { "$ref": "common.json#/$defs/NullableString" }
          }
        },
        "quiet_mode": { "type": "boolean" },
        "rescan_off": {
          "description": "Why Re-read would be refused now: extraction switched off (the sentence POST /api/admin/rescan answers 409 extraction_off with) or no extractor on this server (its 503 unavailable sentence); null while re-reading can run.",
          "$ref": "common.json#/$defs/NullableString"
        }
      }
    },
    "Tonight": {
      "description": "Signed-out sign-in strip: no names, ids, answers, party, channel or version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["time", "bosses", "tally"],
              "properties": {
                "time": { "$ref": "#/$defs/LocalTime" },
                "bosses": { "type": "array", "items": { "type": "string" } },
                "tally": { "$ref": "common.json#/$defs/Tally" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
