{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoshinoht/kanade-bot/boss/knowledge/schema.json",
  "title": "Kanade v5 boss knowledge document (schema v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["boss", "summary", "danger", "tips", "sources"],
  "anyOf": [{ "required": ["core"] }, { "required": ["phases"] }],
  "properties": {
    "boss": {
      "description": "Canonical catalog key (e.g. 'MaleficStar'); file stem is its lowercase form. Event bosses use their own key.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "summary": { "$ref": "#/$defs/text" },
    "lead": { "description": "One-line page lead; the UI falls back to summary.", "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "core": { "$ref": "#/$defs/bullets" },
    "danger": { "$ref": "#/$defs/bullets" },
    "tips": { "$ref": "#/$defs/bullets" },
    "phases": {
      "description": "Core mechanics grouped by phase; core may be omitted when present.",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/phase" }
    },
    "difficulty_notes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": { "^[enhcx]$": { "$ref": "#/$defs/item" } }
    },
    "notes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/item" } },
    "event": { "$ref": "#/$defs/event" },
    "difficulties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/difficulty" }
    },
    "strategies": {
      "description": "Named routes a party can choose between, each with its trade-off.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/strategy" }
    },
    "mechanics": {
      "description": "Reusable diagram blocks: ledger rows, zones, or a range scale.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/mechanic" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "short": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "label": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
    "tag": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
    "figure": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "\\S" },
    "tone": {
      "description": "Named colour role; the UI maps it to tokens and always prints the label too.",
      "enum": ["red", "yellow", "green", "blue", "neutral", "risk", "safe"]
    },
    "item": {
      "description": "A bullet: plain text, or a short bold title with one line of text. `detail` is the full wording only the chatbot reads.",
      "anyOf": [
        { "$ref": "#/$defs/text" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "text"],
          "properties": {
            "title": { "$ref": "#/$defs/label" },
            "text": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "\\S" },
            "detail": { "$ref": "#/$defs/text" }
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "items"],
      "properties": {
        "name": { "$ref": "#/$defs/label" },
        "group": { "description": "Timeline group shared by adjacent phases (e.g. 'Phase 2' for Seren's clock).", "$ref": "#/$defs/label" },
        "cycle": { "description": "The group repeats; every phase in the group sets the same value.", "type": "boolean" },
        "tag": { "description": "Short timeline caption.", "$ref": "#/$defs/label" },
        "tone": { "$ref": "#/$defs/tone" },
        "items": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "mission": {
      "description": "A solo mission run at this difficulty; the API lists every boss in the same series in order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["series", "order", "title"],
      "properties": {
        "series": { "enum": ["destiny-weapon", "union-champion"] },
        "order": { "type": "integer", "minimum": 1, "maximum": 12 },
        "title": { "$ref": "#/$defs/short" },
        "modifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "direction"],
          "properties": {
            "text": { "$ref": "#/$defs/tag" },
            "direction": { "description": "up: in the player's favour.", "enum": ["up", "down"] }
          }
        },
        "needs": { "$ref": "#/$defs/tag" },
        "rules": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/label" } }
      }
    },
    "mechanic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "rows"],
          "properties": {
            "kind": { "const": "ledger" },
            "title": { "$ref": "#/$defs/tag" },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": { "$ref": "#/$defs/tag" },
                  "value": { "$ref": "#/$defs/figure" },
                  "direction": { "description": "up: in the player's favour.", "enum": ["up", "down"] }
                }
              }
            },
            "note": { "$ref": "#/$defs/note" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "zones"],
          "properties": {
            "kind": { "const": "zones" },
            "title": { "$ref": "#/$defs/tag" },
            "zones": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": { "name": { "$ref": "#/$defs/label" }, "sub": { "$ref": "#/$defs/label" }, "tone": { "$ref": "#/$defs/tone" } }
              }
            },
            "note": { "$ref": "#/$defs/note" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "bands"],
          "properties": {
            "kind": { "const": "scale" },
            "title": { "$ref": "#/$defs/tag" },
            "bands": {
              "type": "array",
              "minItems": 2,
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "span"],
                "properties": {
                  "label": { "$ref": "#/$defs/label" },
                  "span": { "description": "Relative width.", "type": "integer", "minimum": 1, "maximum": 100 },
                  "tone": { "$ref": "#/$defs/tone" }
                }
              }
            },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "note": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "bullets": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/item" } },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "availability"],
      "properties": {
        "name": { "$ref": "#/$defs/short" },
        "availability": { "$ref": "#/$defs/text" },
        "aliases": {
          "description": "Other names members use for the boss (spellings, Korean name); matched case-insensitively.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "\\S" }
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "risk", "damage", "payoff", "steps"],
      "properties": {
        "name": { "$ref": "#/$defs/short" },
        "when": { "$ref": "#/$defs/text" },
        "risk": { "enum": ["low", "medium", "high"] },
        "damage": { "description": "Damage requirement.", "enum": ["low", "medium", "high"] },
        "payoff": { "$ref": "#/$defs/text" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["Easy", "Normal", "Hard", "Chaos", "Extreme", "Champion", "Destiny"] },
        "entry_level": { "type": "integer", "minimum": 1, "maximum": 300 },
        "boss_level": { "type": "integer", "minimum": 1, "maximum": 300 },
        "pdr_percent": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "party_max": { "type": "integer", "minimum": 1, "maximum": 6 },
        "force": {
          "description": "Symbol force requirement (Arcane, or Sacred, which MapleSEA calls Authentic Force).",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["arcane", "sacred"] },
            "value": { "type": "integer", "minimum": 1, "maximum": 2000 }
          }
        },
        "hp": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "value"],
            "properties": {
              "phase": {
                "description": "Phase label: '1', '2-1', or 'total' when phases are HP thresholds on one bar.",
                "type": "string",
                "pattern": "^([1-9](-[1-9])?|total)$"
              },
              "value": {
                "description": "Unit-suffixed game value, e.g. '241.5t' or '10.266q'.",
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?[bmtq]$"
              },
              "count": { "description": "Copies at this HP (e.g. three Perils).", "type": "integer", "minimum": 2, "maximum": 6 },
              "target": { "description": "What this row's HP belongs to when a phase is split between targets, e.g. 'Perils' or 'Carling'; shown as 'Phase 3 (Perils)'.", "$ref": "#/$defs/label" }
            }
          }
        },
        "recommended_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "$ref": "#/$defs/short" },
            "text": { "$ref": "#/$defs/text" },
            "value": { "description": "Short figure for a tile, e.g. '≈ 86k'.", "$ref": "#/$defs/figure" },
            "basis": { "description": "Where the figure comes from, e.g. 'KMS, Oct 2025'.", "$ref": "#/$defs/label" }
          }
        },
        "notes": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/item" } },
        "mission": { "$ref": "#/$defs/mission" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "author", "kind", "fetched"],
      "properties": {
        "url": { "type": "string", "maxLength": 2048, "pattern": "^https://[^\\s/]+(/\\S*)?$" },
        "title": { "$ref": "#/$defs/short" },
        "author": { "$ref": "#/$defs/short" },
        "kind": { "enum": ["guide", "wiki", "tool", "official"] },
        "fetched": { "$ref": "#/$defs/date" },
        "updated": { "$ref": "#/$defs/date" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "researched_as_of"],
      "properties": {
        "schema_version": { "const": 2 },
        "researched_as_of": { "$ref": "#/$defs/date" },
        "intended_use": { "$ref": "#/$defs/text" }
      }
    }
  }
}
