# Compose variables for compose.yaml. Copy to .env here (git-ignored);
# Compose reads it for every command run from deploy/. Host paths and image
# labels only: settings belong in ../kanade.toml, secrets in the secrets
# directory. Every line is optional; the defaults are shown.

# Private settings file, mounted read-only at /config/kanade.toml.
# KANADE_CONFIG_FILE=../kanade.toml
# The secrets directory, mounted read-only at /run/secrets: discord_token,
# admin_token, model_api_key and those the add-ons name (runbook "Secrets").
# Absolute path; Compose does not expand `~`. It must already exist.
# KANADE_SECRETS_HOST_DIR=/home/you/.config/kanade/v5/secrets
# Backups directory (and its optional age `recipients` file); it must
# already exist.
# KANADE_BACKUP_HOST_DIR=/home/you/.config/kanade/v5/backups
# The tunnel token for the public portal (profile public only).
# KANADE_CLOUDFLARED_TOKEN_HOST_FILE=/home/you/.config/kanade/v5/cloudflared_token

# OCI labels of `docker compose build` (runbook "Image").
# KANADE_IMAGE_REVISION=unknown
# KANADE_IMAGE_VERSION=dev
# KANADE_IMAGE_SOURCE=https://github.com/hoshinoht/kanade-bot
