# Compose variables for compose.yaml. Copy to .env here (git-ignored);
# Compose reads it for every command run from deploy/. Host paths and image
# labels only: settings belong in ../kanade.toml, secrets in their files.
# Every line is optional; the defaults are shown.

# Private settings file, mounted read-only at /config/kanade.toml.
# KANADE_CONFIG_FILE=../kanade.toml
# Secret files: discord_token, admin_token, model_api_key (and those the
# add-ons name). Absolute path; Compose does not expand `~`.
# KANADE_SECRETS_DIR=/home/you/.config/kanade/v5/secrets
# Backups directory; it must already exist.
# KANADE_BACKUP_HOST_DIR=/home/you/.config/kanade/v5/backups

# Add-ons (runbook "Add-ons"); unset is off.
# age public keys: encrypted backups.
# KANADE_BACKUP_RECIPIENTS_HOST_FILE=/home/you/.config/kanade/v5/secrets/backup_recipients
# NEXON Open API key for module character_data.
# KANADE_NEXON_API_KEY_HOST_FILE=/home/you/.config/kanade/v5/secrets/nexon_api_key
# MapleScouter sidecar, reached on a shared network by its alias.
# KANADE_SCOUTER_URL=http://scouter:8091

# OCI labels of `docker compose build` (runbook "Image").
# KANADE_IMAGE_REVISION=unknown
# KANADE_IMAGE_VERSION=dev
# KANADE_IMAGE_SOURCE=https://github.com/hoshinoht/kanade-bot
