{
  "name": "kanade-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '@kanade/app-*' build",
    "check": "bun run --filter '@kanade/app-*' check",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:rust": "playwright test -c playwright.rust.config.ts",
    "leak": "playwright test e2e/bundle.spec.ts",
    "measure": "bun scripts/measure.ts",
    "fidelity": "bun scripts/fidelity.ts",
    "icons": "bun scripts/icons.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "16.5.0",
    "sass-embedded": "1.105.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-precaching": "7.4.1"
  }
}
