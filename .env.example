# Rust v5 runtime only; copy manually to .env (it is never auto-loaded).
KANADE_TIMEZONE=Asia/Kuala_Lumpur
KANADE_ADMIN_BIND=127.0.0.1:8080
# Public read-only origin (closed until enabled); both hosts must differ.
# KANADE_PUBLIC_BIND=127.0.0.1:8081
# KANADE_ADMIN_HOST=kanade.example
# KANADE_PUBLIC_HOST=kanade-pub.example
# KANADE_TRUSTED_PROXY=
# KANADE_CLOUDFLARED_PEER=
# KANADE_WEB_DIR=
# KANADE_BOSS_DIR=
# KANADE_IDENTITY_DIR=
# Admin sign-in. Secrets are read only from files (e.g. Compose secrets).
# KANADE_ADMIN_DISCORD_CLIENT_ID=
# KANADE_ADMIN_DISCORD_CLIENT_SECRET_FILE=/run/secrets/kanade_discord_client_secret
# KANADE_ADMIN_DISCORD_REDIRECT_URI=https://kanade.example/api/admin/auth/discord/callback
# KANADE_ADMIN_TOKEN_FILE=/run/secrets/kanade_admin_token
# KANADE_ADMIN_TAILSCALE_LOGINS=you@example.com
# KANADE_ADMIN_SESSION_IDLE_MINUTES=60
# KANADE_ADMIN_SESSION_ABSOLUTE_HOURS=12
KANADE_SHUTDOWN_TIMEOUT_SECONDS=10
KANADE_HEALTHCHECK_TIMEOUT_SECONDS=3
# KANADE_HEALTHCHECK_URL=http://127.0.0.1:8080/healthz
