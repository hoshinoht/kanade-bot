# Copy to `.env` and fill in.  `.env` is git-ignored.
# See README.md for where each Discord id comes from.

# ---------------------------------------------------------------- Discord ---
# Bot token from the Developer Portal (Bot -> Reset Token). Keep it secret.
DISCORD_TOKEN=

# Right-click the server icon -> Copy Server ID (needs Developer Mode on).
GUILD_ID=

# WATCHED CHANNELS - set at least one of the next two, or the bot refuses to
# start. `/fixed add` must be run inside a watched channel (that channel becomes
# the run's home channel), and phase 2's extractor reads chat from them.
#
# Explicit text channel ids, comma separated.
CHAT_CHANNEL_IDS=
#
# Category ids, comma separated: every text channel under them is watched, and
# channels added to the category later are picked up without a restart. Threads
# count as their parent channel. This is usually the easier one to set: put all
# your party channels under one `bossing` category and list it here.
CHAT_CATEGORY_IDS=

# OPTIONAL. Each run posts in its own home channel - the channel `/fixed add`
# was invoked in - so you usually do not need this. It is used for guild-wide
# posts (the weekly digest, phase 4) and as a fallback when a run's home channel
# has been deleted or the bot lost access to it.
POST_CHANNEL_ID=

# Everyone with this role is a known bosser and may use the slash commands.
BOSSING_ROLE_ID=

# Optional. Members with this role may modify any run, not just their own.
ADMIN_ROLE_ID=

# Optional. Extra user ids allowed to use /debug, comma separated. The server
# owner and ADMIN_ROLE_ID members always have access.
DEBUG_USER_IDS=

# ------------------------------------------------------------- scheduling ---
# IANA timezone. All times you type into commands are read in this zone.
TZ=Asia/Kuala_Lumpur

# Boss week boundary (MapleSEA-style reset).
BOSS_WEEK_RESET_WEEKDAY=thu
BOSS_WEEK_RESET_TIME=00:00

# Morning ping for the day's runs. Changeable at runtime with /pingtime.
DAY_OF_PING_TIME=01:00

# Countdown pings, minutes before a run, comma separated.
COUNTDOWN_MINUTES=60

# Seconds between reminder-loop ticks (5-600).
TICK_SECONDS=30

# ---------------------------------------------------------------- storage ---
# Inside the container this is overridden to /app/data/bot.sqlite by compose.
DB_PATH=data/bot.sqlite
BOSSES_PATH=config/bosses.yaml

# ----------------------------------------------- phase 2: the chat extractor ---
# Ollama runs natively on the host (Docker on macOS has no GPU passthrough);
# compose points the container at it. From the host itself use 127.0.0.1.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:20b

# Seconds to wait for one extraction. gpt-oss:20b takes roughly 5-40 s for a
# ~2k-token prompt on an M4 Pro; the first call after a cold start also pays for
# loading 13 GB of weights, so keep this generous.
OLLAMA_TIMEOUT=120

# Reasoning effort for gpt-oss-style models: low, medium, high, or off.
# `medium` is ~5x slower here for no measurable accuracy gain - see the fixture
# suite (`uv run pytest -m ollama`) before changing it.
OLLAMA_THINK=low

# Context window. The prompt is built to stay under ~3k tokens; a bigger window
# only costs RAM.
OLLAMA_NUM_CTX=8192

# Master switch for reading chat. When false, messages are still stored (so
# /rescan can catch up later) but no model call is ever made. `/bot pause` is
# the runtime equivalent and survives restarts.
EXTRACT_ENABLED=true

# Silence, in seconds, that ends a burst and triggers one model call. A message
# with a mention/@here AND a boss or a time skips the wait entirely.
EXTRACT_DEBOUNCE_SECONDS=90

# How many earlier messages of the channel (last 48 h) are shown to the model as
# context. 0 disables context entirely.
EXTRACT_CONTEXT_MESSAGES=25

# Below this confidence an extracted amendment is logged and never posted.
EXTRACT_MIN_CONFIDENCE=0.6

# On startup, pull each watched channel's history for the current boss week into
# the database. No model call is made - it only fills `messages`, so /rescan and
# a card's evidence links still work after the database has been reset. One
# paginated read per channel; it writes nothing new on a restart.
BACKFILL_ON_START=true

# ----------------------------------------------- phase 3: portal + bossctl ---
# Bearer token for the local HTTP API, the portal login, and `bossctl`.
# Generate one with:
#   openssl rand -hex 32
# Until this is set the API starts but refuses every request except /healthz,
# so a half-configured deployment fails loudly instead of quietly serving the
# schedule. Rotating it signs every browser session out.
# Put the value on this line with nothing after it - a line that is only a
# comment reads as unset.
ADMIN_TOKEN=

# Tailnet logins allowed through `tailscale serve`, comma separated. These are
# the email addresses Tailscale shows for your account, e.g. you@gmail.com.
# Only consulted when TRUST_TAILSCALE_HEADERS is true.
ALLOWED_TAILSCALE_LOGINS=

# Trust the `Tailscale-User-Login` header on requests arriving from the host.
# Turn this on ONLY when `tailscale serve` is running in front of the port:
#   tailscale serve --bg 8080
# The header is a plain string, so it is trusted purely because of where the
# socket is - compose publishes the port on 127.0.0.1 only, and the only thing
# on this Mac that sets the header is `tailscale serve`. With it off (the
# default) the portal asks for ADMIN_TOKEN on the phone too, which still works.
# NEVER use `tailscale funnel`: that publishes the port to the internet.
TRUST_TAILSCALE_HEADERS=false

# Discord user id credited for changes made in the portal (approving a card
# annotates it "✅ applied via portal", and a `fix` it creates is owned by this
# account). Defaults to the server owner.
PORTAL_ACTOR_ID=

# Where the API binds. Leave this alone: compose overrides it to 0.0.0.0 inside
# the container, because a container's loopback is its own namespace. Running
# the bot natively (`uv run python -m bot`) keeps 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=8080

# Where `bossctl` looks for the API. Only needed if you changed API_PORT or run
# the CLI from another machine on the tailnet.
BOSSCTL_URL=http://127.0.0.1:8080

# --------------------------------------------------------------- logging ----
LOG_LEVEL=INFO
