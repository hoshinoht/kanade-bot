# Copy to `.env` and fill in.  `.env` is git-ignored.
# See README.md for where each Discord id comes from.

# ---------------------------------------------------------------- Discord ---
# Bot token from the Developer Portal (Bot -> Reset Token). Keep it secret.
DISCORD_TOKEN=

# Right-click the server icon -> Copy Server ID (needs Developer Mode on).
GUILD_ID=

# WATCHED CHANNELS - set at least one of the next two, or the bot refuses to
# start. `/fixed add` must be run inside a watched channel (that channel becomes
# the run's home channel), and phase 2's extractor reads chat from them.
#
# Explicit text channel ids, comma separated.
CHAT_CHANNEL_IDS=
#
# Category ids, comma separated: every text channel under them is watched, and
# channels added to the category later are picked up without a restart. Threads
# count as their parent channel. This is usually the easier one to set: put all
# your party channels under one `bossing` category and list it here.
CHAT_CATEGORY_IDS=

# OPTIONAL. Each run posts in its own home channel - the channel `/fixed add`
# was invoked in - so you usually do not need this. It is used for guild-wide
# posts (the weekly digest, phase 4) and as a fallback when a run's home channel
# has been deleted or the bot lost access to it.
POST_CHANNEL_ID=

# Everyone with this role is a known bosser and may use the slash commands.
BOSSING_ROLE_ID=

# Optional, but this is the "who runs the bot" role. Members with it may modify
# any run (not just their own), post as the bot with /say, and use /debug.
# Discord's own Administrator permission and the server owner can do all of that
# too, so leaving this empty locks nobody out - it just means only they can.
ADMIN_ROLE_ID=

# Optional. Extra user ids allowed to use /debug, comma separated - for a tester
# who is deliberately not an admin. The server owner, ADMIN_ROLE_ID members and
# server administrators always have access.
DEBUG_USER_IDS=

# ------------------------------------------------------------- scheduling ---
# IANA timezone. All times you type into commands are read in this zone.
TZ=Asia/Kuala_Lumpur

# Boss week boundary (MapleSEA-style reset).
BOSS_WEEK_RESET_WEEKDAY=thu
BOSS_WEEK_RESET_TIME=00:00

# Morning ping for the day's runs. Changeable at runtime with /pingtime.
DAY_OF_PING_TIME=01:00

# Countdown pings, minutes before a run, comma separated.
COUNTDOWN_MINUTES=60

# Seconds between reminder-loop ticks (5-600).
TICK_SECONDS=30

# ---------------------------------------------------------------- storage ---
# Inside the container this is overridden to /app/data/bot.sqlite by compose.
DB_PATH=data/bot.sqlite
BOSSES_PATH=config/bosses.yaml

# ----------------------------------------------- phase 2: the chat extractor ---
# Ollama runs natively on the host (Docker on macOS has no GPU passthrough);
# compose points the container at it. From the host itself use 127.0.0.1.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:20b

# Seconds to wait for one extraction. gpt-oss:20b takes roughly 5-40 s for a
# ~2k-token prompt on an M4 Pro; the first call after a cold start also pays for
# loading 13 GB of weights, so keep this generous.
OLLAMA_TIMEOUT=120

# Reasoning effort for gpt-oss-style models: low, medium, high, or off.
# `medium` is ~5x slower here for no measurable accuracy gain - see the fixture
# suite (`uv run pytest -m ollama`) before changing it.
OLLAMA_THINK=low

# Context window. The prompt is built to stay under ~3k tokens; a bigger window
# only costs RAM.
OLLAMA_NUM_CTX=8192

# Master switch for reading chat. When false, messages are still stored (so
# /rescan can catch up later) but no model call is ever made. `/bot pause` is
# the runtime equivalent and survives restarts.
EXTRACT_ENABLED=true

# Silence, in seconds, that ends a burst and triggers one model call. A message
# with a mention/@here AND a boss or a time skips the wait entirely.
EXTRACT_DEBOUNCE_SECONDS=90

# How many earlier messages of the channel (last 48 h) are shown to the model as
# context. 0 disables context entirely.
EXTRACT_CONTEXT_MESSAGES=25

# Below this confidence an extracted amendment is logged and never posted.
EXTRACT_MIN_CONFIDENCE=0.6

# Automated re-reads (anything the bot starts by itself) are capped at 48 hours
# and never widen to the previous week - only a person asking can choose `week`
# or `2weeks`. This is enforced in code, not by convention.
#
# On startup, pull each watched channel's history for the current boss week into
# the database. No model call is made - it only fills `messages`, so /rescan and
# a card's evidence links still work after the database has been reset. One
# paginated read per channel; it writes nothing new on a restart.
BACKFILL_ON_START=true

# ----------------------------------------------- phase 3: portal + bossctl ---
# Bearer token for the local HTTP API, the portal login, and `bossctl`.
# Generate one with:
#   openssl rand -hex 32
# Until this is set the API starts but refuses every request except /healthz,
# so a half-configured deployment fails loudly instead of quietly serving the
# schedule. Rotating it signs every browser session out.
# Put the value on this line with nothing after it - a line that is only a
# comment reads as unset.
ADMIN_TOKEN=

# Tailnet logins allowed through `tailscale serve`, comma separated. These are
# the email addresses Tailscale shows for your account, e.g. you@gmail.com.
# Only consulted when TRUST_TAILSCALE_HEADERS is true.
ALLOWED_TAILSCALE_LOGINS=

# Trust the `Tailscale-User-Login` header on requests arriving from the host.
# Turn this on ONLY when `tailscale serve` is running in front of the port:
#   tailscale serve --bg 8080
# The header is a plain string, so it is trusted purely because of where the
# socket is - compose publishes the port on 127.0.0.1 only, and the only thing
# on the host that sets the header is `tailscale serve`. With it off (the
# default) the portal asks for ADMIN_TOKEN on the phone too, which still works.
# NEVER use `tailscale funnel`: that publishes the port to the internet.
# NEVER turn this on behind the caddy service (docs/portal.md): a reverse proxy
# forwards whatever header the client sent, and its requests arrive from the
# Docker bridge, which passes the local-peer check the trust relies on. Behind
# Caddy the header carries no identity anyway - leave this off and use the token.
TRUST_TAILSCALE_HEADERS=false

# Discord user id credited for changes made in the portal (approving a card
# annotates it "✅ applied via portal", and a `fix` it creates is owned by this
# account). Defaults to the server owner.
PORTAL_ACTOR_ID=

# Where the API binds. Leave this alone: compose overrides it to 0.0.0.0 inside
# the container, because a container's loopback is its own namespace. Running
# the bot natively (`uv run python -m bot`) keeps 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=8080

# Where `bossctl` looks for the API. Only needed if you changed API_PORT or run
# the CLI from another machine on the tailnet.
BOSSCTL_URL=http://127.0.0.1:8080

# Where compose publishes the caddy service's port 443 (the portal's HTTPS
# front door, replacing `tailscale serve` as of 2026-09-01). Set it to this
# host's Tailscale IP so the name resolves publicly but only tailnet devices
# can connect; the loopback default keeps a fresh clone off the network
# entirely. Two more pieces live outside this file: the hostname goes in
# caddy/Caddyfile (copy caddy/Caddyfile.example), and the Cloudflare API token
# goes in .env.caddy as CLOUDFLARE_API_TOKEN=... (both untracked).
CADDY_BIND_IP=127.0.0.1

# ------------------------------------------- phase 4: the speech pilot -------
# A chatbot that answers scheduling questions and drafts changes as the same
# ✅/❌ proposal cards the extractor posts. It runs on the same local Ollama; no
# message ever leaves the machine.
#
# It is off until CHAT_PILOT_ROLE_ID and at least one of the two lists below are
# set, and it is silent to everyone else: a member without the role, or a message
# in another channel, gets no reply and no reaction at all.
#
# NOTE the `CHAT_PILOT_` prefix. `CHAT_CHANNEL_IDS` / `CHAT_CATEGORY_IDS` above
# are different lists - what the *extractor* reads - and the two pairs must not
# be confused. The chatbot normally lives in its own channel, which is
# deliberately NOT watched: talking to the bot should not turn into proposals
# about the schedule.
#
# The two pairs are independent, NOT mutually exclusive. Putting your bossing
# category in CHAT_PILOT_CATEGORY_IDS below really does let the bot answer in
# every party channel under it - including ones added to that category later.
# That may be what you want; it is not a safe default. Prefer naming one channel
# in CHAT_PILOT_CHANNEL_IDS, and reach for the category list only when you mean
# "every channel in here, present and future".

# The role a member must hold to talk to the bot. Unset = nobody can.
CHAT_PILOT_ROLE_ID=

# The channels it answers in, comma separated. Make a channel for this rather
# than using a party channel.
CHAT_PILOT_CHANNEL_IDS=

# Categories whose text channels it answers in, comma separated. Resolved per
# message, so a channel added to the category later is picked up without a
# restart; threads count as their parent channel. A message qualifies if its
# channel is in the list above OR its category is in this one.
# Both lists empty = the feature is off.
# Read the warning above before setting this to a category that holds party
# channels: every channel under it becomes a channel the bot answers in.
CHAT_PILOT_CATEGORY_IDS=

# Replies per person per window before it stops answering them and reacts ⏳
# (and, once per episode, says when to come back). ADMIN_ROLE_ID holders are
# exempt, so testing it does not use up your own.
#
# SEED ONLY. This and the three numbers below are copied into the database on
# first run and are runtime settings from then on: the portal's Config page and
# `bossctl config set chat_pilot_rate_count 6` change them live, and the stored
# value wins over this file at every later restart. Editing here after first run
# changes nothing. Individual members can be given their own allowance instead,
# on the portal's Limits page or with `bossctl limits set <who> <n> <seconds>`.
CHAT_PILOT_RATE_COUNT=4
CHAT_PILOT_RATE_WINDOW_S=300

# Replies per window for the whole guild put together, on top of the per-person
# limit above, and refused with the same ⏳. The per-person window stops one
# member monopolising the model; this stops twenty of them doing it between
# them, so handing CHAT_PILOT_ROLE_ID to more people cannot turn the host into a
# queue nobody gets through. ADMIN_ROLE_ID holders neither spend from this pool
# nor are refused by it. Seed only, like the pair above: once the bot has run,
# these live in the database and are edited from the portal or `bossctl`.
CHAT_PILOT_GLOBAL_RATE_COUNT=12
CHAT_PILOT_GLOBAL_RATE_WINDOW_S=900

# How long a question waits for the model before it is turned away with 💬
# rather than queued. There is one 13 GB model on the machine and one call runs
# at a time - another channel's answer, an extraction, a rescan - so this is the
# "shed instead of queue" knob: past a couple of seconds the asker has moved on,
# and a late reply is worse than a visible "not now". ADMIN_ROLE_ID holders
# instead wait CHAT_PILOT_TIMEOUT, which puts them at the front of the queue for
# the next free slot rather than shedding them.
CHAT_PILOT_LOCK_WAIT_S=2

# How long one remembered exchange stays in a channel's conversation, in
# seconds. Old turns are dropped when the next prompt is built - there is no
# timer - and the age is measured per turn, so a live back-and-forth never
# loses anything. It is here because stale memory is worse than none: "move it
# to 22:00" an hour after the thing it referred to was settled otherwise binds
# to a dead topic. The same clock retires the "last card in this channel" line.
# Raise it for a slow channel; lower it if the bot keeps dragging old runs in.
CHAT_PILOT_HISTORY_TTL_S=2700

# The model that answers. Separate from OLLAMA_MODEL so the extractor's model
# can be changed without also changing the bot's voice.
CHAT_PILOT_MODEL=gpt-oss:20b

# Seconds for one whole answer, including any tool calls it makes.
CHAT_PILOT_TIMEOUT=60

# Sampling temperature for the chatbot, 0-2. NOT the extractor's 0: that one is
# reading a schedule out of chat, where the only good answer is the literal one,
# while this is holding a conversation and a greedy decode reads like a form
# letter. Warmth is safe here because every change it drafts is a card somebody
# still has to ✅. Raise it if replies feel flat, lower it if it starts
# embroidering. `top_p` is left at the model's own default on purpose.
CHAT_PILOT_TEMPERATURE=0.7

# The persona document, loaded verbatim into the system prompt. It is NOT in
# git - it is deployment flavour text - so it lives on the data volume beside
# the database. Compose overrides this to /app/data/persona.md; copy your file
# in with:
#   docker compose cp your-persona.md bot:/app/data/persona.md
# A missing file falls back to the tracked `persona.example.md` and logs a
# WARNING, so a wrong path is obvious in the logs without taking the bot down.
PERSONA_PATH=data/persona.md

# --------------------------------------------------------------- logging ----
LOG_LEVEL=INFO
