#!/bin/sh
# Pre-push hook mirroring CI's slow gate: full test suite minus live model
# gateway calls. Enable once per clone: git config core.hooksPath .githooks
set -e

cd legacy/python

if ! command -v uv >/dev/null 2>&1; then
  echo "githooks: uv not found, skipping checks" >&2
  exit 0
fi

uv run pytest -q -m "not live_model"
